        </div>

        <div class="home-toc-grid">
            <a href="#home-properties" class="home-toc-link" data-home-toc-target="home-properties">
                <span class="home-toc-link-title">{{ trans('home.toc_properties_title') }}</span>
                <span class="home-toc-link-copy">{{ trans('home.toc_properties_copy') }}</span>
            </a>
            <a href="#home-info-request" class="home-toc-link" data-home-toc-target="home-info-request">
