{% extends "layout.html.twig" %}

{% block content %}
<section class="property-public-shell">
    <div class="property-public-header">
        <h1>{{ trans('properties.title') }}</h1>
    </div>

    <div class="property-filter-bar">
        <span class="property-filter-label">{{ trans('properties.filter_label') }}</span>
        <div class="property-filter-actions">
            <a href="{{ base_path }}/properties?lang={{ app_lang }}&mode=all" class="property-filter-link {{ selected_mode == 'all' ? 'active' : '' }}">
                {{ trans('properties.filter_all') }}
            </a>
            <a href="{{ base_path }}/properties?lang={{ app_lang }}&mode=achat" class="property-filter-link {{ selected_mode == 'achat' ? 'active' : '' }}">
                {{ trans('properties.mode_buy') }}
            </a>
            <a href="{{ base_path }}/properties?lang={{ app_lang }}&mode=location" class="property-filter-link {{ selected_mode == 'location' ? 'active' : '' }}">
                {{ trans('properties.mode_rent') }}
            </a>
        </div>
    </div>

    {% if properties is empty %}
        <div class="property-empty-state property-empty-state-public">
            <p>{{ trans('properties.empty') }}</p>
        </div>
    {% else %}
        <div class="property-public-grid">
            {% for property in properties %}
                <article class="property-public-card">
                    <img src="{{ property.image_url }}" alt="{{ property.name }}" class="property-public-image">

                    <p class="property-public-mode">{{ property.listing_mode == 'location' ? trans('properties.mode_rent') : trans('properties.mode_buy') }}</p>
                    <h2>{{ property.name }}</h2>
                    <p class="property-public-city">{{ property.city }}</p>
                    <p class="property-public-price property-public-price-primary">{{ property.primary_price_display }}</p>
                    <p class="property-public-price property-public-price-secondary">{{ property.secondary_price_display }}</p>

                    <a href="{{ property.external_url }}" target="_blank" rel="noopener noreferrer" class="property-public-link">
                        {{ trans('properties.cta') }}
                    </a>
                </article>
            {% endfor %}
        </div>
    {% endif %}
</section>
{% endblock %}
