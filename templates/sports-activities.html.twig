{% extends "layout.html.twig" %}

{% block content %}
<section class="about-hero">
    <p>{{ hero_text }}</p>
</section>

<section class="residency-container restaurant-page-shell">
    <h1>{{ title_text }}</h1>
    <p>{{ intro_text }}</p>

    {% if activity_categories is empty %}
        <div class="residency-note">
            <h2>{{ trans('sports_activities.coming_title') }}</h2>
            <p>{{ trans('sports_activities.coming_copy') }}</p>
        </div>
    {% else %}
        <div class="restaurant-category-list">
            {% for category in activity_categories %}
                <section class="restaurant-category" id="activity-category-{{ loop.index }}">
                    <div class="restaurant-category-header">
                        <h2>{{ category.title }}</h2>
                        <span>
                            {{ category.items|length }}
                            {{ app_lang == 'fr'
                                ? (category.items|length == 1 ? 'activité' : 'activités')
                                : (app_lang == 'es'
                                    ? (category.items|length == 1 ? 'actividad' : 'actividades')
                                    : (category.items|length == 1 ? 'activity' : 'activities')) }}
                        </span>
                    </div>

                    <div class="restaurant-grid">
                        {% for item in category.items %}
                            {% set primary_media = item.media|first %}
                            <article class="restaurant-card">
                                {% if primary_media %}
                                    <div class="property-card-media property-card-media-public">
                                        {% if primary_media.type == 'video' %}
                                            <video class="property-public-image" controls preload="metadata" playsinline>
                                                <source src="{{ primary_media.url starts with '/uploads/' ? base_path ~ primary_media.url : primary_media.url }}">
                                            </video>
                                        {% else %}
                                            <img
                                                src="{{ primary_media.url starts with '/uploads/' ? base_path ~ primary_media.url : primary_media.url }}"
                                                alt="{{ item.name }}"
                                                class="property-public-image"
                                                loading="lazy"
                                            >
                                        {% endif %}
                                    </div>
                                {% endif %}

                                <div class="restaurant-card-top">
                                    <h3>{{ item.name }}</h3>
                                </div>

                                {% if item.area %}
                                    <p class="restaurant-area">
                                        <a
                                            href="https://www.google.com/maps/search/?api=1&query={{ (item.name ~ ' ' ~ item.area ~ ' Playa del Carmen')|url_encode }}"
                                            class="restaurant-area-link"
                                            target="_blank"
                                            rel="noopener noreferrer"
                                        >
                                            {{ app_lang == 'fr'
                                                ? "Pour l'adresse, cliquez ici"
                                                : (app_lang == 'es'
                                                    ? 'Para la dirección, haz clic aquí'
                                                    : 'For the address, click here') }}
                                        </a>
                                    </p>
                                {% endif %}

                                {% if item.description %}
                                    <p class="guide-note">{{ item.description }}</p>
                                {% endif %}

                                {% if item.url %}
                                    <a href="{{ item.url starts with '/' ? base_path ~ item.url : item.url }}" class="guide-link" target="_blank" rel="noopener noreferrer">
                                        {{ item.url_label ? item.url_label : item.url }}
                                    </a>
                                {% endif %}
                            </article>
                        {% endfor %}
                    </div>
                </section>
            {% endfor %}
        </div>
    {% endif %}

    <div class="page-home-actions">
        <a href="{{ base_path }}/?lang={{ app_lang }}" class="info-request-link page-home-link">{{ trans('common.back_home') }}</a>
    </div>
</section>
{% endblock %}
