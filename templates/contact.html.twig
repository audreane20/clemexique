{% extends "layout.html.twig" %}

{% block content %}

<section class="contact-hero">
    <h1>{{ trans('contact.title') }}</h1>
    <p>{{ trans('contact.subtitle') }}</p>
</section>

<section class="contact-container">

    {% if success %}
        <div class="form-success">
            {{ trans('contact.success') }}
        </div>
    {% endif %}

    {% if error %}
        <div class="form-error">
            {{ error }}
        </div>
    {% endif %}

    <form class="contact-form" method="POST" action="{{ base_path }}/contact">
        <input type="hidden" name="preferred_language" value="{{ app_lang }}">
        <input type="text" name="website" value="" tabindex="-1" autocomplete="off" class="contact-honeypot" aria-hidden="true">

        <div class="form-group">
            <label>{{ trans('contact.name') }}</label>
            <input type="text" name="name" value="{{ name }}" required>
        </div>

        <div class="form-group">
            <label>{{ trans('contact.email') }}</label>
            <input type="email" name="email" value="{{ email }}" required>
        </div>

        <div class="form-group">
            <label>{{ trans('contact.phone') }}</label>
            <input type="text" name="phone" value="{{ phone }}">
        </div>

        <div class="form-group">
            <label>{{ trans('contact.project') }}</label>
            <input type="text" name="project" value="{{ project }}">
        </div>

        <div class="form-group">
            <label>{{ trans('contact.subject') }}</label>
            <input type="text" name="subject" value="{{ subject }}">
        </div>

        <div class="form-group">
            <label>{{ trans('contact.message') }}</label>
            <textarea name="message" rows="6" required>{{ message }}</textarea>
        </div>

        <div class="form-group">
            <label>{{ trans('contact.captcha_label', {'%left%': captcha_left, '%right%': captcha_right}) }}</label>
            <input type="text" name="captcha_answer" inputmode="numeric" autocomplete="off" required>
        </div>

        <button type="submit" class="contact-btn">
            {{ trans('contact.submit') }}
        </button>
    </form>

    <div class="page-home-actions">
        <a href="{{ base_path }}/?lang={{ app_lang }}" class="info-request-link">{{ trans('common.back_home') }}</a>
    </div>

</section>

{% endblock %}
