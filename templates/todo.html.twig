{% extends "layout.html.twig" %}

{% block content %}
<section class="about-hero">
    <p>{{ hero_text }}</p>
</section>

<section class="residency-container">
    <h1>{{ title_text }}</h1>
    <p>{{ intro_text }}</p>

    <div class="residency-note">
        <h2>{{ section_title }}</h2>
        <p>{{ section_copy }}</p>
    </div>

    <section class="home-toc-shell restaurant-toc-shell">
        <div class="home-toc-card">
            <div class="home-toc-copy">
                <p class="home-toc-eyebrow">{{ toc_eyebrow }}</p>
                <h2>{{ toc_title }}</h2>
                <p>{{ toc_copy }}</p>
            </div>
            <div class="home-toc-grid">
                {% for category in guide_categories %}
                    <a href="#guide-category-{{ loop.index }}" class="home-toc-link" data-guide-toc-target="guide-category-{{ loop.index }}">
                        <span class="home-toc-link-title">{{ category.title }}</span>
                        <span class="home-toc-link-copy">
                            {{ category.items|length }}
                            {{ app_lang == 'fr'
                                ? 'idees'
                                : (category.items|length == 1 ? 'idea' : 'ideas') }}
                        </span>
                    </a>
                {% endfor %}
            </div>
        </div>
    </section>

    <section class="guide-map-card" aria-labelledby="guide-map-title">
        <div class="guide-map-copy">
            <p class="guide-map-eyebrow">{{ trans('playa_guide.map_eyebrow') }}</p>
            <h2 id="guide-map-title">{{ trans('playa_guide.map_title') }}</h2>
            <p>{{ trans('playa_guide.map_copy') }}</p>
        </div>
        <figure class="guide-map-figure">
            <button
                type="button"
                class="guide-map-link property-lightbox-trigger"
                data-map-lightbox-trigger
                data-lightbox-image="{{ base_path }}/Images/Map_CLeMexique.png"
                data-lightbox-alt="{{ trans('playa_guide.map_alt') }}"
                aria-label="{{ trans('playa_guide.map_caption') }}"
            >
                <img
                    src="{{ base_path }}/Images/Map_CLeMexique.png"
                    alt="{{ trans('playa_guide.map_alt') }}"
                    class="guide-map-image"
                    loading="lazy"
                >
            </button>
            <figcaption>{{ trans('playa_guide.map_caption') }}</figcaption>
        </figure>
    </section>

    <div class="guide-category-list">
        {% for category in guide_categories %}
            <section class="guide-category" id="guide-category-{{ loop.index }}">
                <div class="guide-category-header">
                    <h2>{{ category.title }}</h2>
                    <span>
                        {{ category.items|length }}
                        {{ app_lang == 'fr'
                            ? 'idees'
                            : (category.items|length == 1 ? 'idea' : 'ideas') }}
                    </span>
                </div>

                <div class="guide-grid">
                    {% for item in category.items %}
                        <article class="guide-card">
                            <div class="guide-card-top">
                                <h3>{{ item.name }}</h3>
                                {% if item.video_url %}
                                    <a
                                        href="{{ item.video_url }}"
                                        class="guide-video-link"
                                        target="_blank"
                                        rel="noopener noreferrer"
                                        aria-label="{{ app_lang == 'fr' ? 'Voir la video' : (app_lang == 'es' ? 'Ver video' : 'Watch video') }}"
                                        title="{{ app_lang == 'fr' ? 'Voir la video' : (app_lang == 'es' ? 'Ver video' : 'Watch video') }}"
                                    >
                                        <svg viewBox="0 0 24 24" aria-hidden="true" focusable="false">
                                            <path d="M23.5 6.2a3 3 0 0 0-2.1-2.1C19.4 3.5 12 3.5 12 3.5s-7.4 0-9.4.6A3 3 0 0 0 .5 6.2 31.4 31.4 0 0 0 0 12a31.4 31.4 0 0 0 .5 5.8 3 3 0 0 0 2.1 2.1c2 .6 9.4.6 9.4.6s7.4 0 9.4-.6a3 3 0 0 0 2.1-2.1A31.4 31.4 0 0 0 24 12a31.4 31.4 0 0 0-.5-5.8ZM9.6 15.6V8.4L15.8 12l-6.2 3.6Z"/>
                                        </svg>
                                    </a>
                                {% endif %}
                            </div>

                            {% if item.area %}
                                <p class="guide-area">
                                    <a
                                        href="https://www.google.com/maps/search/?api=1&query={{ (item.name ~ ' ' ~ item.area ~ ' Playa del Carmen')|url_encode }}"
                                        class="restaurant-area-link"
                                        target="_blank"
                                        rel="noopener noreferrer"
                                    >
                                        {{ app_lang == 'fr' ? 'Pour l\'adresse, cliquez ici' : (app_lang == 'es' ? 'Para la direccion, haz clic aqui' : 'For the address, click here') }}
                                    </a>
                                </p>
                            {% endif %}

                            {% if item.note %}
                                <p class="guide-note">{{ item.note }}</p>
                            {% endif %}

                            {% if item.url %}
                                <a href="{{ item.url starts with '/' ? base_path ~ item.url : item.url }}" class="guide-link" target="_blank" rel="noopener noreferrer">{{ item.url_label }}</a>
                            {% endif %}
                        </article>
                    {% endfor %}
                </div>
            </section>
        {% endfor %}
    </div>

    <div class="page-home-actions">
        <a href="{{ base_path }}/contact?lang={{ app_lang }}&subject={{ title_text|url_encode }}" class="info-request-link">{{ contact_cta }}</a>
        <a href="{{ base_path }}/?lang={{ app_lang }}" class="info-request-link page-home-link">{{ trans('common.back_home') }}</a>
    </div>
</section>

<div class="property-lightbox" data-property-lightbox hidden>
    <button type="button" class="property-lightbox-close" data-property-lightbox-close aria-label="{{ trans('properties.close_gallery') }}">X</button>
    <div class="property-lightbox-backdrop" data-property-lightbox-close></div>
    <div class="property-lightbox-dialog" role="dialog" aria-modal="true" aria-label="{{ trans('playa_guide.map_title') }}">
        <img src="" alt="" data-property-lightbox-image>
    </div>
</div>
{% endblock %}

{% block scripts %}
<script>
document.addEventListener('DOMContentLoaded', function () {
    const lightbox = document.querySelector('[data-property-lightbox]');
    const lightboxImage = document.querySelector('[data-property-lightbox-image]');
    const mapTrigger = document.querySelector('[data-map-lightbox-trigger]');
    const tocLinks = document.querySelectorAll('[data-guide-toc-target]');
    let highlightTimer = null;
    let highlightedElement = null;
    let scrollStopTimer = null;

    if (lightbox && lightboxImage && mapTrigger) {
        const openLightbox = function () {
            lightboxImage.src = mapTrigger.dataset.lightboxImage || '';
            lightboxImage.alt = mapTrigger.dataset.lightboxAlt || '';
            lightbox.hidden = false;
            document.body.style.overflow = 'hidden';
        };

        const closeLightbox = function () {
            lightbox.hidden = true;
            lightboxImage.src = '';
            lightboxImage.alt = '';
            document.body.style.overflow = '';
        };

        mapTrigger.addEventListener('click', openLightbox);

        document.querySelectorAll('[data-property-lightbox-close]').forEach(function (closer) {
            closer.addEventListener('click', closeLightbox);
        });

        document.addEventListener('keydown', function (event) {
            if (lightbox.hidden) {
                return;
            }

            if (event.key === 'Escape') {
                closeLightbox();
            }
        });
    }

    const resolveHighlightElement = function (target) {
        if (!target) {
            return null;
        }

        return target;
    };

    const highlightTarget = function (target) {
        const element = resolveHighlightElement(target);

        if (!element) {
            return;
        }

        if (highlightedElement && highlightedElement !== element) {
            highlightedElement.classList.remove('quick-scroll-highlight');
        }

        element.classList.remove('quick-scroll-highlight');
        void element.offsetWidth;
        element.classList.add('quick-scroll-highlight');
        highlightedElement = element;

        if (highlightTimer) {
            window.clearTimeout(highlightTimer);
        }

        highlightTimer = window.setTimeout(function () {
            element.classList.remove('quick-scroll-highlight');
            if (highlightedElement === element) {
                highlightedElement = null;
            }
        }, 1100);
    };

    const highlightAfterArrival = function (target) {
        const finish = function () {
            window.removeEventListener('scrollend', finish);
            window.removeEventListener('scroll', onScroll);
            if (scrollStopTimer) {
                window.clearTimeout(scrollStopTimer);
                scrollStopTimer = null;
            }
            highlightTarget(target);
        };

        const onScroll = function () {
            if (scrollStopTimer) {
                window.clearTimeout(scrollStopTimer);
            }

            scrollStopTimer = window.setTimeout(finish, 120);
        };

        window.addEventListener('scrollend', finish, { once: true });
        window.addEventListener('scroll', onScroll);
        onScroll();
    };

    tocLinks.forEach(function (link) {
        link.addEventListener('click', function (event) {
            const targetId = link.getAttribute('data-guide-toc-target');
            const target = targetId ? document.getElementById(targetId) : null;

            if (!target) {
                return;
            }

            event.preventDefault();
            target.scrollIntoView({ behavior: 'smooth', block: 'start' });
            highlightAfterArrival(target);
        });
    });
});
</script>
{% endblock %}

