<div class="property-lightbox" data-property-lightbox hidden>
    <button type="button" class="property-lightbox-close" data-property-lightbox-close aria-label="{{ trans('properties.close_gallery') }}">X</button>
    <div class="property-lightbox-backdrop" data-property-lightbox-close></div>
    <div class="property-lightbox-dialog" role="dialog" aria-modal="true" aria-label="{{ trans('playa_guide.map_title') }}">
        <img src="" alt="" data-property-lightbox-image>
    </div>
</div>

<script>
document.addEventListener('DOMContentLoaded', function () {
    const heroShell = document.querySelector('[data-home-hero-shell]');
    const heroCard = document.querySelector('[data-home-hero-card]');
    const heroSun = document.querySelector('.home-hero-orb-sun');
    const params = new URLSearchParams(window.location.search);
    const lightbox = document.querySelector('[data-property-lightbox]');
    const lightboxImage = document.querySelector('[data-property-lightbox-image]');
    const mapTrigger = document.querySelector('[data-map-lightbox-trigger]');

    if (params.get('transition') === 'sun') {
        if (heroSun) {
            const sunRect = heroSun.getBoundingClientRect();
            const targetX = sunRect.left + (sunRect.width / 2);
            const targetY = sunRect.top + (sunRect.height / 2);

            document.documentElement.style.setProperty('--home-transition-sun-target-x', targetX.toFixed(1) + 'px');
            document.documentElement.style.setProperty('--home-transition-sun-target-y', targetY.toFixed(1) + 'px');
            document.documentElement.style.setProperty('--home-transition-sun-target-size', sunRect.width.toFixed(1) + 'px');
        }

        document.body.classList.add('home-transition-sun-active');

        window.setTimeout(function () {
            document.body.classList.remove('home-transition-sun-active');
        }, 1700);

        params.delete('transition');
        const nextQuery = params.toString();
        const nextUrl = window.location.pathname + (nextQuery ? '?' + nextQuery : '') + window.location.hash;
        window.history.replaceState({}, document.title, nextUrl);
    }

    if (heroShell && heroCard) {
        const updateHeroScrollState = function () {
            const rect = heroShell.getBoundingClientRect();
            const viewportHeight = window.innerHeight || document.documentElement.clientHeight || 1;
            const visibleTop = Math.max(rect.top, 0);
            const visibleBottom = Math.min(rect.bottom, viewportHeight);
            const visibleHeight = Math.max(0, visibleBottom - visibleTop);
            const visibility = Math.max(0, Math.min(visibleHeight / Math.max(rect.height, 1), 1));
            const fadeOpacity = 0.12 + (visibility * 0.88);

            heroCard.style.setProperty('--hero-scroll-visibility', visibility.toFixed(3));
            heroCard.style.setProperty('--hero-fade-opacity', fadeOpacity.toFixed(3));
        };

        updateHeroScrollState();
        window.addEventListener('scroll', updateHeroScrollState, { passive: true });
        window.addEventListener('resize', updateHeroScrollState);
    }

    if (lightbox && lightboxImage && mapTrigger) {
        const openLightbox = function () {
            lightboxImage.src = mapTrigger.dataset.lightboxImage || '';
            lightboxImage.alt = mapTrigger.dataset.lightboxAlt || '';
            lightbox.hidden = false;
            document.body.style.overflow = 'hidden';
        };

        const closeLightbox = function () {
            lightbox.hidden = true;
            lightboxImage.src = '';
            lightboxImage.alt = '';
            document.body.style.overflow = '';
        };

        mapTrigger.addEventListener('click', openLightbox);

        document.querySelectorAll('[data-property-lightbox-close]').forEach(function (closer) {
            closer.addEventListener('click', closeLightbox);
        });

        document.addEventListener('keydown', function (event) {
            if (lightbox.hidden) {
                return;
            }

            if (event.key === 'Escape') {
                closeLightbox();
            }
        });
    }
});
</script>
