{% extends "layout.html.twig" %}

{% block head %}
<style>
.transport-admin-confirm-dialog {
    width: min(100%, 560px);
}

.transport-admin-confirm-actions {
    display: grid;
    grid-template-columns: 1fr;
    gap: 12px;
    margin-top: 22px;
}

.transport-admin-confirm-action {
    width: 100%;
    text-align: center;
    box-sizing: border-box;
    min-height: 52px;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    padding: 12px 18px;
    border-radius: 18px;
    font: inherit;
    font-size: 1rem;
    font-weight: 800;
    line-height: 1.2;
    cursor: pointer;
}

.transport-admin-confirm-action[hidden] {
    display: none !important;
}

.transport-admin-confirm-delete {
    background: #fff3f3;
    color: #9b1c1c;
    border: 1px solid rgba(155, 28, 28, 0.18);
}

.transport-admin-confirm-secondary {
    background: rgba(31, 163, 179, 0.1);
    color: var(--navy);
    border: 1px solid rgba(11, 53, 88, 0.14);
}

.transport-admin-confirm-cancel {
    background: #ffffff;
    color: var(--navy);
    border: 2px solid rgba(11, 53, 88, 0.55);
}
</style>
{% endblock %}

{% block content %}
{% set price_options = ['$', '$$', '$$$', '$$$$', '$$$$$'] %}
{% set is_restaurants = active_section == 'restaurants' %}
{% set is_video_capsules = active_section == 'video_capsules' %}
{% set is_activities = active_section == 'activities' %}
{% set is_transportation = active_section == 'transportation' %}
{% set item_label_key = active_section == 'restaurants'
    ? 'admin_content.item_label.restaurant'
    : active_section == 'excursions'
        ? 'admin_content.item_label.excursion'
        : active_section == 'video_capsules'
            ? 'admin_content.item_label.video_capsule'
        : active_section == 'activities'
            ? 'admin_content.item_label.sports_activity'
        : active_section == 'transportation'
            ? 'admin_content.item_label.transportation'
        : 'admin_content.item_label.activity' %}
{% set current_item_label = trans(item_label_key) %}
{% set add_title = trans('admin_content.sections.' ~ active_section ~ '.add_title') %}
{% set ui = {
    'eyebrow': trans('admin_content.ui.eyebrow'),
    'edit': trans('admin_content.ui.edit'),
    'editing_copy': trans('admin_content.ui.editing_copy'),
    'create_copy': trans('admin_content.ui.create_copy'),
    'cancel': trans('admin_content.ui.cancel'),
    'category': trans('admin_content.ui.category'),
    'select_category': trans('admin_content.ui.select_category'),
    'new_category': trans('admin_content.ui.new_category'),
    'new_category_copy': trans('admin_content.ui.new_category_copy'),
    'search_icon': trans('admin_content.ui.search_icon'),
    'no_matching_icons': trans('admin_content.ui.no_matching_icons'),
    'preview': trans('admin_content.ui.preview'),
    'no_icon': trans('admin_content.ui.no_icon'),
    'unknown_code': trans('admin_content.ui.unknown_code'),
    'optional': trans('admin_content.ui.optional'),
    'select_price': trans('admin_content.ui.select_price'),
    'favorite_pick': trans('admin_content.ui.favorite_pick'),
    'select_reference': trans('admin_content.ui.select_reference'),
    'no_reference': trans('admin_content.ui.no_reference'),
    'save': trans('admin_content.ui.save'),
    'current_sections': trans('admin_content.ui.current_sections'),
    'categories': trans('admin_content.ui.categories'),
    'no_categories': trans('admin_content.ui.no_categories'),
    'items': trans('admin_content.ui.items'),
    'delete_category_confirm': trans('admin_content.ui.delete_category_confirm'),
    'delete': trans('admin_content.ui.delete'),
    'empty_restaurants': trans('admin_content.ui.empty_restaurants'),
    'empty_items': trans('admin_content.ui.empty_items'),
    'delete_item_confirm': trans('admin_content.ui.delete_item_confirm'),
    'media_upload_label': trans('admin_content.ui.media_upload_label'),
    'media_upload_help': trans('admin_content.ui.media_upload_help'),
    'video_upload_label': trans('admin_content.ui.video_upload_label'),
    'video_upload_help': trans('admin_content.ui.video_upload_help'),
    'current_video': trans('admin_content.ui.current_video'),
    'open_video': trans('admin_content.ui.open_video'),
    'open_video_link': trans('admin_content.ui.open_video_link')
} %}
{% set submit_add_label = add_title %}
{% set submit_save_label = ui.save|format(current_item_label) %}
{% set required_item_fields = section_config.required_item_fields is defined
    ? section_config.required_item_fields
    : (is_restaurants ? ['name', 'area', 'price', 'url'] : ['name', 'area', 'url']) %}
{% set optional_item_fields = section_config.optional_item_fields is defined
    ? section_config.optional_item_fields
    : (is_restaurants ? ['reference'] : ['note', 'video_url']) %}
{% set is_editing_category = editing_category is defined and editing_category is not null %}
{% set is_editing_item = (not is_editing_category) and editing_item is not null %}
{% set item_form_action = is_editing_item ? base_path ~ '/admin/content/' ~ active_section ~ '/items/' ~ editing_item_category_index ~ '/' ~ editing_item_index ~ '/update' : base_path ~ '/admin/content/' ~ active_section ~ '/items/create' %}
{% set category_form_action = is_editing_category ? base_path ~ '/admin/content/' ~ active_section ~ '/categories/' ~ editing_category_index ~ '/update' : '' %}
{% set selected_category_choice = is_editing_item ? editing_item_category_index : (categories is empty ? '__new__' : '') %}
{% set selected_transport_categories = is_editing_item and editing_item.category_indexes is defined ? editing_item.category_indexes : [] %}
{% set native_submit_enabled = (section_config.native_submit is defined and section_config.native_submit)
    or (section_config.show_video_upload is defined and section_config.show_video_upload)
    or (section_config.show_media_upload is defined and section_config.show_media_upload) %}
{% set transport_delete_choice_copy = editor_language == 'fr'
    ? 'Cette compagnie apparaît dans plusieurs catégories. Voulez-vous la supprimer partout ou seulement de cette catégorie ?'
    : (editor_language == 'es'
        ? 'Esta empresa aparece en varias categorías. ¿Quieres eliminarla de todas las categorías o solo de esta?'
        : 'This company appears in multiple categories. Do you want to delete it from every category or only this one?') %}
{% set transport_delete_all_label = editor_language == 'fr'
    ? 'Supprimer partout'
    : (editor_language == 'es' ? 'Eliminar de todas' : 'Delete everywhere') %}
{% set transport_delete_single_label = editor_language == 'fr'
    ? 'Seulement cette catégorie'
    : (editor_language == 'es' ? 'Solo esta categoría' : 'Only this category') %}
<section class="admin-content-shell">
    <div class="admin-properties-header">
        <div>
            <p class="admin-properties-eyebrow">{{ ui.eyebrow }}</p>
            <h1>{{ trans(section_config.page_title) }}</h1>
            <p>{{ trans(section_config.page_copy) }}</p>
        </div>
    </div>

    {% if flash_success %}
        <div class="form-success">{{ flash_success }}</div>
    {% endif %}

    {% if flash_error %}
        <div class="form-error">{{ flash_error }}</div>
    {% endif %}

    <div class="admin-content-layout">
        <section class="admin-content-card admin-content-create-card">
            <div class="admin-content-form-header">
                <div>
                    <h2>
                        {% if is_editing_category %}
                            {{ ui.edit ~ ' ' ~ ui.category }}
                        {% elseif is_editing_item %}
                            {{ ui.edit ~ ' ' ~ current_item_label }}
                        {% else %}
                            {{ add_title }}
                        {% endif %}
                    </h2>
                    <p>
                        {% if is_editing_category %}
                            {{ ui.editing_copy|format(ui.category|lower) }}
                        {% elseif is_editing_item %}
                            {{ ui.editing_copy|format(current_item_label) }}
                        {% else %}
                            {{ ui.create_copy }}
                        {% endif %}
                    </p>
                </div>
                {% if is_editing_item or is_editing_category %}
                    <a href="{{ base_path }}/admin/content/{{ active_section }}?lang={{ editor_language }}" class="admin-content-cancel-link">{{ ui.cancel }}</a>
                {% endif %}
            </div>

            <form method="POST" action="{{ is_editing_category ? category_form_action : item_form_action }}" class="admin-content-form" data-admin-content-form {% if native_submit_enabled and not is_editing_category %}data-admin-content-native-submit="true"{% endif %} enctype="multipart/form-data">
                <input type="hidden" name="editor_language" value="{{ editor_language }}">

                {% if is_editing_category %}
                    {% for field in section_config.category_fields %}
                        <label>
                            <span class="admin-content-label-copy">
                                {{ trans(field.label_key) }}
                                {% if field.name == 'title' %}
                                    <span class="admin-content-required-marker">*</span>
                                {% endif %}
                            </span>
                            {% if field.name == 'flag' %}
                                <div class="admin-content-icon-picker" data-category-icon-picker>
                                    <input type="hidden" name="category_flag" value="{{ editing_category.flag|default('') }}" data-category-icon-value>
                                    <input type="text" value="{{ editing_category.flag|default('') }}" placeholder="{{ ui.search_icon }}" autocomplete="off" data-category-icon-input>
                                    <div class="admin-content-icon-picker-menu is-hidden" data-category-icon-menu>
                                        {% for choice in category_icon_choices %}
                                            <button type="button" class="admin-content-icon-option" data-icon-code="{{ choice.code }}" data-icon-label="{{ choice.name }}">
                                                <span class="admin-content-icon-option-symbol">{{ render_category_icon(choice.code) }}</span>
                                                <span class="admin-content-icon-option-copy">
                                                    <strong>{{ choice.name }}</strong>
                                                    <span>{{ choice.code }}</span>
                                                </span>
                                            </button>
                                        {% endfor %}
                                        <div class="admin-content-icon-empty is-hidden" data-category-icon-empty>
                                            {{ ui.no_matching_icons }}
                                        </div>
                                    </div>
                                </div>
                                <div class="admin-content-icon-preview" data-category-icon-preview>
                                    <span class="admin-content-icon-preview-label">{{ ui.preview }}</span>
                                    <span class="admin-content-icon-preview-value">
                                        {% if editing_category.flag %}
                                            {{ render_category_icon(editing_category.flag) }}<span>{{ editing_category.flag }}</span>
                                        {% else %}
                                            {{ ui.no_icon }}
                                        {% endif %}
                                    </span>
                                </div>
                            {% else %}
                                <input type="text" name="category_title" value="{{ editing_category.title|default('') }}" placeholder="{{ trans(field.placeholder_key) }}">
                            {% endif %}
                        </label>
                    {% endfor %}
                {% else %}
                {% if is_transportation %}
                    <fieldset class="admin-content-checkbox-group">
                        <legend class="admin-content-label-copy">{{ ui.category }}<span class="admin-content-required-marker">*</span></legend>
                        <div class="admin-content-checkbox-list">
                            {% for category in categories %}
                                <label class="admin-content-checkbox-option">
                                    <input
                                        type="checkbox"
                                        name="category_choices[]"
                                        value="{{ loop.index0 }}"
                                        {{ loop.index0 in selected_transport_categories ? 'checked' : '' }}
                                    >
                                    <span>{{ category.title }}</span>
                                </label>
                            {% endfor %}
                            <label class="admin-content-checkbox-option admin-content-checkbox-option-new">
                                <input type="checkbox" value="1" data-transport-new-category-toggle>
                                <span>{{ ui.new_category }}</span>
                            </label>
                        </div>

                        <div class="admin-content-new-category-fields is-hidden" data-transport-new-category-fields>
                            <div class="admin-content-inline-title admin-content-inline-title-compact">
                                <h3>{{ ui.new_category }}</h3>
                                <p>{{ ui.new_category_copy|format(current_item_label) }}</p>
                            </div>

                            <input type="text" name="new_category_title" value="" placeholder="{{ trans('admin_content.sections.transportation.category_title_placeholder') }}" disabled>
                        </div>
                    </fieldset>
                {% else %}
                    <label>
                        <span class="admin-content-label-copy">{{ ui.category }}<span class="admin-content-required-marker">*</span></span>
                        <select name="category_choice" data-category-choice>
                            {% if categories is not empty %}
                                <option value="">{{ ui.select_category }}</option>
                                {% for category in categories %}
                                    <option value="{{ loop.index0 }}" {{ selected_category_choice == loop.index0 ? 'selected' : '' }}>
                                        {{ category.title }}
                                    </option>
                                {% endfor %}
                            {% endif %}
                            <option value="__new__" {{ selected_category_choice == '__new__' ? 'selected' : '' }}>{{ ui.new_category }}</option>
                        </select>
                    </label>

                    <div class="admin-content-new-category-fields is-hidden" data-new-category-fields>
                        <div class="admin-content-inline-title">
                            <h3>{{ ui.new_category }}</h3>
                            <p>{{ ui.new_category_copy|format(current_item_label) }}</p>
                        </div>

                        {% for field in section_config.category_fields %}
                            <label>
                                {{ trans(field.label_key) }}
                                {% if field.name == 'flag' %}
                                    <div class="admin-content-icon-picker" data-category-icon-picker>
                                        <input type="hidden" name="new_category_{{ field.name }}" value="" data-category-icon-value>
                                        <input type="text" value="" placeholder="{{ ui.search_icon }}" autocomplete="off" data-category-icon-input>
                                        <div class="admin-content-icon-picker-menu is-hidden" data-category-icon-menu>
                                            {% for choice in category_icon_choices %}
                                                <button type="button" class="admin-content-icon-option" data-icon-code="{{ choice.code }}" data-icon-label="{{ choice.name }}">
                                                    <span class="admin-content-icon-option-symbol">{{ render_category_icon(choice.code) }}</span>
                                                    <span class="admin-content-icon-option-copy">
                                                        <strong>{{ choice.name }}</strong>
                                                        <span>{{ choice.code }}</span>
                                                    </span>
                                                </button>
                                            {% endfor %}
                                            <div class="admin-content-icon-empty is-hidden" data-category-icon-empty>
                                                {{ ui.no_matching_icons }}
                                            </div>
                                        </div>
                                    </div>
                                    <div class="admin-content-icon-preview" data-category-icon-preview>
                                        <span class="admin-content-icon-preview-label">{{ ui.preview }}</span>
                                        <span class="admin-content-icon-preview-value">{{ ui.no_icon }}</span>
                                    </div>
                                {% else %}
                                    <input type="text" name="new_category_{{ field.name }}" value="" placeholder="{{ trans(field.placeholder_key) }}">
                                {% endif %}
                            </label>
                        {% endfor %}
                    </div>
                {% endif %}

                {% for field in section_config.item_fields %}
                    {% if field.name != 'url_label' %}
                    <label>
                        <span class="admin-content-label-copy">
                            {{ trans(field.label_key) }}
                            {% if field.name in required_item_fields %}
                                <span class="admin-content-required-marker">*</span>
                            {% elseif field.name in optional_item_fields %}
                                <span class="admin-content-optional-marker">({{ ui.optional }})</span>
                            {% endif %}
                        </span>
                        {% if is_restaurants and field.name == 'price' %}
                            <select name="{{ field.name }}">
                                <option value="">{{ ui.select_price }}</option>
                                {% for option in price_options %}
                                    <option value="{{ option }}" {{ is_editing_item and attribute(editing_item, field.name)|default('') == option ? 'selected' : '' }}>{{ option }}</option>
                                {% endfor %}
                            </select>
                        {% elseif is_restaurants and field.name == 'reference' %}
                            {% set current_reference = is_editing_item ? attribute(editing_item, field.name)|default('') : '' %}
                            {% set current_reference_lower = current_reference|lower %}
                            {% set favorite_reference_value = ui.favorite_pick %}
                            {% set tripadvisor_reference_value = 'Tripadvisor 2025' %}
                            {% set selected_reference_value = '' %}
                            {% if 'tripadvisor' in current_reference_lower %}
                                {% set selected_reference_value = tripadvisor_reference_value %}
                            {% elseif 'favorite pick' in current_reference_lower or 'coup de coeur' in current_reference_lower or 'coup de cÅ“ur' in current_reference_lower %}
                                {% set selected_reference_value = favorite_reference_value %}
                            {% endif %}

                            <div class="admin-content-reference-picker" data-reference-picker>
                                <input type="hidden" name="{{ field.name }}" value="{{ selected_reference_value }}" data-reference-value>
                                <button type="button" class="admin-content-reference-trigger" data-reference-trigger aria-haspopup="listbox" aria-expanded="false">
                                    <span class="admin-content-reference-trigger-content" data-reference-trigger-content>
                                        {% if selected_reference_value == favorite_reference_value %}
                                            <span class="restaurant-reference-badge restaurant-reference-badge-heart">
                                                <span class="restaurant-reference-heart" aria-hidden="true">&#10084;</span>
                                                <span>{{ favorite_reference_value }}</span>
                                            </span>
                                        {% elseif selected_reference_value == tripadvisor_reference_value %}
                                            <span class="admin-content-reference-choice-render">
                                                <span class="restaurant-reference-badge restaurant-reference-badge-tripadvisor">
                                                    <img src="{{ base_path }}/Images/tripadvisor_logo.webp" alt="Tripadvisor Travelers' Choice Awards 2025" class="restaurant-reference-tripadvisor-logo">
                                                </span>
                                                <span class="admin-content-reference-choice-label">{{ tripadvisor_reference_value }}</span>
                                            </span>
                                        {% else %}
                                            <span class="admin-content-reference-placeholder">{{ ui.select_reference }}</span>
                                        {% endif %}
                                    </span>
                                </button>

                                <div class="admin-content-reference-menu is-hidden" data-reference-menu role="listbox">
                                    <button type="button" class="admin-content-reference-option" data-reference-option data-reference-value="">
                                        <span class="admin-content-reference-choice-render">
                                            <span class="admin-content-reference-placeholder">{{ ui.no_reference }}</span>
                                        </span>
                                    </button>

                                    <button type="button" class="admin-content-reference-option" data-reference-option data-reference-value="{{ favorite_reference_value }}">
                                        <span class="admin-content-reference-choice-render">
                                            <span class="restaurant-reference-badge restaurant-reference-badge-heart">
                                                <span class="restaurant-reference-heart" aria-hidden="true">&#10084;</span>
                                                <span>{{ favorite_reference_value }}</span>
                                            </span>
                                        </span>
                                    </button>

                                    <button type="button" class="admin-content-reference-option" data-reference-option data-reference-value="{{ tripadvisor_reference_value }}">
                                        <span class="admin-content-reference-choice-render">
                                            <span class="restaurant-reference-badge restaurant-reference-badge-tripadvisor">
                                                <img src="{{ base_path }}/Images/tripadvisor_logo.webp" alt="Tripadvisor Travelers' Choice Awards 2025" class="restaurant-reference-tripadvisor-logo">
                                            </span>
                                            <span class="admin-content-reference-choice-label">{{ tripadvisor_reference_value }}</span>
                                        </span>
                                    </button>
                                </div>
                            </div>
                        {% elseif field.type is defined and field.type == 'textarea' %}
                            <textarea name="{{ field.name }}" rows="4" placeholder="{{ trans(field.placeholder_key) }}">{{ is_editing_item ? attribute(editing_item, field.name)|default('') : '' }}</textarea>
                        {% else %}
                            <input type="text" name="{{ field.name }}" value="{{ is_editing_item ? attribute(editing_item, field.name)|default('') : '' }}" placeholder="{{ trans(field.placeholder_key) }}">
                        {% endif %}
                    </label>
                    {% endif %}
                {% endfor %}

                {% if section_config.show_media_upload is defined and section_config.show_media_upload %}
                    <label>
                        <span class="admin-content-label-copy">
                            {{ ui.media_upload_label }}
                            <span class="admin-content-optional-marker">({{ ui.optional }})</span>
                        </span>
                        <input type="file" name="media_files[]" accept="image/jpeg,image/png,image/webp,image/gif,image/avif,video/mp4,video/quicktime,video/webm,.jpg,.jpeg,.png,.webp,.gif,.avif,.mp4,.mov,.m4v,.webm" multiple>
                        <span class="admin-content-field-help">
                            {{ ui.media_upload_help }}
                        </span>
                        {% if is_editing_item and editing_item.media is defined and editing_item.media %}
                            <div class="admin-content-item-meta">
                                {% for media in editing_item.media %}
                                    {% if media.type == 'image' %}
                                        <a href="{{ base_path ~ media.url }}" target="_blank" rel="noopener noreferrer">
                                            <img src="{{ base_path ~ media.url }}" alt="{{ editing_item.name }} media {{ loop.index }}" class="admin-content-media-thumb">
                                        </a>
                                    {% elseif media.type == 'video' %}
                                        <video controls preload="metadata" class="guide-video-player admin-content-video-preview">
                                            <source src="{{ base_path ~ media.url }}">
                                        </video>
                                    {% endif %}
                                {% endfor %}
                            </div>
                        {% endif %}
                    </label>
                {% endif %}

                {% if section_config.show_video_upload is defined and section_config.show_video_upload %}
                    <label>
                        <span class="admin-content-label-copy">
                            {{ ui.video_upload_label }}
                            <span class="admin-content-optional-marker">({{ ui.optional }})</span>
                        </span>
                        <input type="file" name="video_file" accept="video/mp4,video/quicktime,video/webm,.mp4,.mov,.m4v,.webm">
                        <span class="admin-content-field-help">
                            {{ ui.video_upload_help }}
                        </span>
                        {% if is_editing_item and editing_item.video_url %}
                            <span class="admin-content-field-help">
                                {{ ui.current_video }}
                                {{ editing_item.video_url }}
                            </span>
                        {% endif %}
                    </label>
                {% endif %}
                {% endif %}

                <button type="submit" class="contact-btn">
                    {% if is_editing_category %}
                        {{ ui.save|format(ui.category|lower) }}
                    {% elseif is_editing_item %}
                        {{ submit_save_label }}
                    {% else %}
                        {{ submit_add_label }}
                    {% endif %}
                </button>
            </form>
        </section>

        <section class="admin-content-preview-panel admin-content-preview">
            <div class="admin-content-preview-header">
                <div>
                    <p class="property-preview-label">{{ ui.current_sections }}</p>
                    <h2>{{ categories|length }} {{ ui.categories }}</h2>
                </div>
            </div>

            {% if categories is empty %}
                <div class="property-empty-state">
                    <p>{{ ui.no_categories }}</p>
                </div>
            {% else %}
                <div class="admin-content-quick-links">
                    {% for category in categories %}
                        <a href="#category-section-{{ loop.index0 }}" class="admin-content-quick-link">
                            {% if category.flag %}
                                {{ render_category_icon(category.flag) }}
                            {% endif %}
                            <span>{{ category.title }}</span>
                        </a>
                    {% endfor %}
                </div>
                <div class="admin-content-category-list">
                    {% for category in categories %}
                        {% set category_index = loop.index0 %}
                        <article class="admin-content-category-card" id="category-section-{{ category_index }}">
                            <div class="admin-content-category-header">
                                <div>
                                    <div class="admin-content-category-title-row">
                                        <h3>{{ category.title }}</h3>
                                        {% if category.flag %}
                                            {{ render_category_icon(category.flag) }}
                                        {% endif %}
                                    </div>
                                    <p>{{ category.items|length }} {{ ui.items }}</p>
                                </div>

                                {% if not is_transportation %}
                                    <div class="admin-content-card-actions">
                                        <a href="{{ base_path }}/admin/content/{{ active_section }}?lang={{ editor_language }}&edit_category={{ category_index }}#category-section-{{ category_index }}" class="header-auth-link">{{ ui.edit }}</a>

                                        <form method="POST" action="{{ base_path }}/admin/content/{{ active_section }}/categories/{{ category_index }}/delete" data-admin-content-action data-confirm-message="{{ ui.delete_category_confirm }}">
                                            <input type="hidden" name="editor_language" value="{{ editor_language }}">
                                            <button type="submit" class="account-menu-button property-delete-button">{{ ui.delete }}</button>
                                        </form>
                                    </div>
                                {% endif %}
                            </div>

                            <div class="admin-content-item-list">
                                {% if category.items is empty %}
                                    <div class="admin-content-empty-items">
                                        {{ is_restaurants ? ui.empty_restaurants : ui.empty_items }}
                                    </div>
                                {% else %}
                                    {% for item in category.items %}
                                        {% set item_index = loop.index0 %}
                                        <article class="admin-content-item-card">
                                            <div class="admin-content-item-summary">
                                                <div class="admin-content-item-summary-main">
                                                    <h4>{{ item.name }}</h4>
                                                    <p>
                                                        {% if item.area %}<span>{{ item.area }}</span>{% endif %}
                                                        {% if item.price %}<span>{{ item.price }}</span>{% endif %}
                                                        {% if item.reference %}<span>{{ item.reference }}</span>{% endif %}
                                                        {% if is_transportation and item.url_label %}<span>{{ item.url_label }}</span>{% endif %}
                                                    </p>
                                                </div>

                                                <div class="admin-content-card-actions">
                                                    <a href="{{ base_path }}/admin/content/{{ active_section }}?lang={{ editor_language }}&edit_item_category={{ category_index }}&edit_item={{ item_index }}" class="header-auth-link">{{ ui.edit }}</a>

                                                    <form method="POST" action="{{ base_path }}/admin/content/{{ active_section }}/items/{{ category_index }}/{{ item_index }}/delete" data-admin-content-action data-confirm-message="{{ ui.delete_item_confirm }}"{% if is_transportation and item.category_count|default(1) > 1 %} data-multi-category-delete="true" data-multi-category-message="{{ transport_delete_choice_copy }}" data-delete-all-label="{{ transport_delete_all_label }}" data-delete-single-label="{{ transport_delete_single_label }}"{% endif %}>
                                                        <input type="hidden" name="editor_language" value="{{ editor_language }}">
                                                        <input type="hidden" name="delete_scope" value="all" data-delete-scope>
                                                        <button type="submit" class="account-menu-button property-delete-button">{{ ui.delete }}</button>
                                                    </form>
                                                </div>
                                            </div>

                                            {% if is_video_capsules and item.video_url %}
                                                <div class="admin-content-item-meta admin-content-video-meta">
                                                    {% if item.video_url starts with '/uploads/video-capsules/' %}
                                                        <video controls preload="metadata" class="guide-video-player admin-content-video-preview">
                                                            <source src="{{ base_path ~ item.video_url }}">
                                                        </video>
                                                        <a href="{{ base_path ~ item.video_url }}" target="_blank" rel="noopener noreferrer" class="guide-link">
                                                            {{ ui.open_video }}
                                                        </a>
                                                    {% else %}
                                                        <a href="{{ item.video_url }}" target="_blank" rel="noopener noreferrer" class="guide-link">
                                                            {{ ui.open_video_link }}
                                                        </a>
                                                    {% endif %}
                                                    {% if item.note %}
                                                        <p class="guide-area">{{ item.note }}</p>
                                                    {% endif %}
                                                </div>
                                            {% elseif is_activities %}
                                                <div class="admin-content-item-meta">
                                                    {% if item.description %}
                                                        <p class="guide-area">{{ item.description }}</p>
                                                    {% endif %}
                                                    {% if item.url %}
                                                        <a href="{{ item.url }}" target="_blank" rel="noopener noreferrer" class="guide-link">{{ item.url_label ? item.url_label : item.url }}</a>
                                                    {% endif %}
                                                    {% if item.media is defined and item.media %}
                                                        <div class="admin-content-item-meta">
                                                            {% for media in item.media %}
                                                                {% if media.type == 'image' %}
                                                                    <a href="{{ base_path ~ media.url }}" target="_blank" rel="noopener noreferrer">
                                                                        <img src="{{ base_path ~ media.url }}" alt="{{ item.name }} media {{ loop.index }}" class="admin-content-media-thumb">
                                                                    </a>
                                                                {% elseif media.type == 'video' %}
                                                                    <video controls preload="metadata" class="guide-video-player admin-content-video-preview">
                                                                        <source src="{{ base_path ~ media.url }}">
                                                                    </video>
                                                                {% endif %}
                                                            {% endfor %}
                                                        </div>
                                                    {% endif %}
                                                </div>
                                            {% elseif item.url %}
                                                <div class="admin-content-item-meta">
                                                    <a href="{{ item.url }}" target="_blank" rel="noopener noreferrer" class="guide-link">{{ item.url_label ? item.url_label : item.url }}</a>
                                                </div>
                                            {% endif %}
                                        </article>
                                    {% endfor %}
                                {% endif %}
                            </div>
                        </article>
                    {% endfor %}
                </div>
            {% endif %}
        </section>
    </div>
</section>

<div class="admin-confirm-modal transport-admin-confirm-modal" data-admin-confirm-modal hidden>
    <button type="button" class="admin-confirm-backdrop" data-admin-confirm-cancel aria-label="{{ ui.cancel }}"></button>
    <div class="admin-confirm-dialog transport-admin-confirm-dialog" role="dialog" aria-modal="true" aria-labelledby="admin-confirm-title">
        <p class="admin-confirm-eyebrow" id="admin-confirm-title">{{ ui.eyebrow }}</p>
        <h3>{{ ui.delete }}</h3>
        <p data-admin-confirm-message></p>
        <div class="transport-admin-confirm-actions">
            <button type="button" class="transport-admin-confirm-action transport-admin-confirm-secondary" data-admin-confirm-submit-single hidden>{{ transport_delete_single_label }}</button>
            <button type="button" class="transport-admin-confirm-action transport-admin-confirm-delete" data-admin-confirm-submit-default>{{ ui.delete }}</button>
            <button type="button" class="transport-admin-confirm-action transport-admin-confirm-delete" data-admin-confirm-submit-all hidden>{{ transport_delete_all_label }}</button>
            <button type="button" class="transport-admin-confirm-action transport-admin-confirm-cancel" data-admin-confirm-cancel>{{ ui.cancel }}</button>
        </div>
    </div>
</div>
{% endblock %}

{% block scripts %}
<script>
document.addEventListener('DOMContentLoaded', function () {
    const categoryChoice = document.querySelector('[data-category-choice]');
    const newCategoryFields = document.querySelector('[data-new-category-fields]');
    const transportNewCategoryToggle = document.querySelector('[data-transport-new-category-toggle]');
    const transportNewCategoryFields = document.querySelector('[data-transport-new-category-fields]');
    const categoryIconPicker = document.querySelector('[data-category-icon-picker]');
    const categoryIconInput = document.querySelector('[data-category-icon-input]');
    const categoryIconValue = document.querySelector('[data-category-icon-value]');
    const categoryIconPreview = document.querySelector('[data-category-icon-preview]');
    const categoryIconMenu = document.querySelector('[data-category-icon-menu]');
    const categoryIconEmpty = document.querySelector('[data-category-icon-empty]');
    const referencePicker = document.querySelector('[data-reference-picker]');
    const referenceValue = document.querySelector('[data-reference-value]');
    const referenceTrigger = document.querySelector('[data-reference-trigger]');
    const referenceTriggerContent = document.querySelector('[data-reference-trigger-content]');
    const referenceMenu = document.querySelector('[data-reference-menu]');
    const referenceOptions = Array.from(document.querySelectorAll('[data-reference-option]'));
    const categoryIconChoices = {
        {% for choice in category_icon_choices %}
        '{{ choice.code }}': {
            label: '{{ choice.name }} ({{ choice.code }})',
            html: {{ render_category_icon(choice.code)|json_encode|raw }}
        }{{ not loop.last ? ',' : '' }}
        {% endfor %}
    };

    if (categoryChoice && newCategoryFields) {
        const syncNewCategoryFields = function () {
            const showNewCategory = categoryChoice.value === '__new__';
            newCategoryFields.classList.toggle('is-hidden', !showNewCategory);

            newCategoryFields.querySelectorAll('input').forEach(function (input) {
                input.disabled = !showNewCategory;
            });
        };

        categoryChoice.addEventListener('change', syncNewCategoryFields);
        syncNewCategoryFields();
    }

    if (transportNewCategoryToggle && transportNewCategoryFields) {
        const transportNewCategoryInput = transportNewCategoryFields.querySelector('input[name="new_category_title"]');
        const syncTransportNewCategoryFields = function () {
            const showNewCategory = transportNewCategoryToggle.checked;
            transportNewCategoryFields.classList.toggle('is-hidden', !showNewCategory);

            if (transportNewCategoryInput) {
                transportNewCategoryInput.disabled = !showNewCategory;
            }
        };

        transportNewCategoryToggle.addEventListener('change', syncTransportNewCategoryFields);
        syncTransportNewCategoryFields();
    }

    if (!categoryIconInput || !categoryIconPreview || !categoryIconValue || !categoryIconMenu || !categoryIconEmpty || !categoryIconPicker) {
        return;
    }

    const previewValue = categoryIconPreview.querySelector('.admin-content-icon-preview-value');
    const iconOptions = Array.from(document.querySelectorAll('.admin-content-icon-option'));

    const syncCategoryIconPreview = function () {
        const code = categoryIconValue.value.trim().toUpperCase();
        const choice = categoryIconChoices[code];

        if (!choice) {
            previewValue.textContent = code === ''
                ? '{{ ui.no_icon }}'
                : '{{ ui.unknown_code }}';
            return;
        }

        previewValue.innerHTML = choice.html + '<span>' + choice.label + '</span>';
    };

    const closeIconMenu = function () {
        categoryIconMenu.classList.add('is-hidden');
    };

    const filterIconOptions = function () {
        const query = categoryIconInput.value.trim().toLowerCase();
        let visibleCount = 0;

        iconOptions.forEach(function (option) {
            const code = option.dataset.iconCode.toLowerCase();
            const label = option.dataset.iconLabel.toLowerCase();
            const matches = query === '' || code.includes(query) || label.includes(query);
            option.classList.toggle('is-hidden', !matches);

            if (matches) {
                visibleCount += 1;
            }
        });

        categoryIconEmpty.classList.toggle('is-hidden', visibleCount !== 0);
    };

    const openIconMenu = function () {
        categoryIconMenu.classList.remove('is-hidden');
        filterIconOptions();
    };

    iconOptions.forEach(function (option) {
        option.addEventListener('click', function () {
            const code = option.dataset.iconCode;
            const label = option.dataset.iconLabel;
            const choice = categoryIconChoices[code];

            categoryIconValue.value = code;
            categoryIconInput.value = choice ? (label + ' (' + code + ')') : code;
            syncCategoryIconPreview();
            closeIconMenu();
        });
    });

    categoryIconInput.addEventListener('focus', openIconMenu);
    categoryIconInput.addEventListener('input', function () {
        categoryIconValue.value = '';
        openIconMenu();
        syncCategoryIconPreview();
    });
    document.addEventListener('click', function (event) {
        if (!categoryIconPicker.contains(event.target)) {
            closeIconMenu();
        }
    });

    syncCategoryIconPreview();

    if (referencePicker && referenceValue && referenceTrigger && referenceTriggerContent && referenceMenu) {
        const closeReferenceMenu = function () {
            referenceMenu.classList.add('is-hidden');
            referenceTrigger.setAttribute('aria-expanded', 'false');
        };

        const openReferenceMenu = function () {
            referenceMenu.classList.remove('is-hidden');
            referenceTrigger.setAttribute('aria-expanded', 'true');
        };

        referenceTrigger.addEventListener('click', function () {
            if (referenceMenu.classList.contains('is-hidden')) {
                openReferenceMenu();
            } else {
                closeReferenceMenu();
            }
        });

        referenceOptions.forEach(function (option) {
            option.addEventListener('click', function () {
                referenceValue.value = option.dataset.referenceValue || '';
                referenceTriggerContent.innerHTML = option.querySelector('.admin-content-reference-choice-render').innerHTML;
                closeReferenceMenu();
            });
        });

        document.addEventListener('click', function (event) {
            if (!referencePicker.contains(event.target)) {
                closeReferenceMenu();
            }
        });
    }
});
</script>
<script>
document.addEventListener('DOMContentLoaded', function () {
    const confirmModal = document.querySelector('[data-admin-confirm-modal]');
    const confirmMessage = document.querySelector('[data-admin-confirm-message]');
    const confirmSubmitDefaultButton = document.querySelector('[data-admin-confirm-submit-default]');
    const confirmSubmitAllButton = document.querySelector('[data-admin-confirm-submit-all]');
    const confirmSubmitSingleButton = document.querySelector('[data-admin-confirm-submit-single]');
    const confirmCancelButtons = document.querySelectorAll('[data-admin-confirm-cancel]');
    const quickLinks = document.querySelectorAll('.admin-content-quick-link');
    let pendingActionForm = null;
    let pendingDeleteMode = 'default';
    let highlightTimer = null;
    let highlightedElement = null;

    const submitAdminContentAction = function (form, loadingLabel) {
        const submitButton = form.querySelector('button[type="submit"]');
        const originalLabel = submitButton ? submitButton.textContent : '';

        if (submitButton) {
            submitButton.disabled = true;
            submitButton.textContent = loadingLabel;
        }

        fetch(form.action, {
            method: 'POST',
            body: new FormData(form),
            credentials: 'same-origin',
            headers: {
                'X-Requested-With': 'XMLHttpRequest'
            }
        })
            .then(function (response) {
                const nextUrl = response.url || window.location.href;

                return fetch(nextUrl, {
                    method: 'GET',
                    credentials: 'same-origin',
                    cache: 'no-store',
                    headers: {
                        'X-Requested-With': 'XMLHttpRequest'
                    }
                });
            })
            .then(function (response) {
                return response.text();
            })
            .then(function (html) {
                document.open();
                document.write(html);
                document.close();
            })
            .catch(function () {
                window.location.reload();
            })
            .finally(function () {
                if (submitButton && document.body.contains(submitButton)) {
                    submitButton.disabled = false;
                    submitButton.textContent = originalLabel;
                }
            });
    };

    const closeConfirmModal = function () {
        if (!confirmModal) {
            return;
        }

        confirmModal.hidden = true;
        document.body.classList.remove('admin-confirm-open');
        if (confirmSubmitSingleButton) {
            confirmSubmitSingleButton.hidden = true;
        }
        if (confirmSubmitDefaultButton) {
            confirmSubmitDefaultButton.hidden = false;
        }
        if (confirmSubmitAllButton) {
            confirmSubmitAllButton.hidden = true;
        }
        pendingActionForm = null;
        pendingDeleteMode = 'default';
    };

    const openConfirmModal = function (form) {
        if (!confirmModal || !confirmMessage) {
            return false;
        }

        pendingActionForm = form;
        const isMultiCategoryDelete = form.dataset.multiCategoryDelete === 'true';
        confirmMessage.textContent = isMultiCategoryDelete
            ? (form.dataset.multiCategoryMessage || form.dataset.confirmMessage || '')
            : (form.dataset.confirmMessage || '');
        if (confirmSubmitSingleButton) {
            confirmSubmitSingleButton.hidden = !isMultiCategoryDelete;
        }
        if (confirmSubmitDefaultButton) {
            confirmSubmitDefaultButton.hidden = isMultiCategoryDelete;
        }
        if (confirmSubmitAllButton) {
            confirmSubmitAllButton.hidden = !isMultiCategoryDelete;
        }
        confirmModal.hidden = false;
        document.body.classList.add('admin-confirm-open');
        return true;
    };

    if (confirmSubmitDefaultButton) {
        confirmSubmitDefaultButton.addEventListener('click', function () {
            if (!pendingActionForm) {
                closeConfirmModal();
                return;
            }

            const formToSubmit = pendingActionForm;
            const deleteScopeInput = formToSubmit.querySelector('[data-delete-scope]');
            if (deleteScopeInput) {
                deleteScopeInput.value = 'all';
            }
            closeConfirmModal();
            submitAdminContentAction(formToSubmit, '{{ ui.deleting }}');
        });
    }

    if (confirmSubmitAllButton) {
        confirmSubmitAllButton.addEventListener('click', function () {
            if (!pendingActionForm) {
                closeConfirmModal();
                return;
            }

            const formToSubmit = pendingActionForm;
            const deleteScopeInput = formToSubmit.querySelector('[data-delete-scope]');
            if (deleteScopeInput) {
                deleteScopeInput.value = 'all';
            }
            closeConfirmModal();
            submitAdminContentAction(formToSubmit, '{{ ui.deleting }}');
        });
    }

    if (confirmSubmitSingleButton) {
        confirmSubmitSingleButton.addEventListener('click', function () {
            if (!pendingActionForm) {
                closeConfirmModal();
                return;
            }

            const formToSubmit = pendingActionForm;
            const deleteScopeInput = formToSubmit.querySelector('[data-delete-scope]');
            if (deleteScopeInput) {
                deleteScopeInput.value = 'single_category';
            }
            closeConfirmModal();
            submitAdminContentAction(formToSubmit, '{{ ui.deleting }}');
        });
    }

    confirmCancelButtons.forEach(function (button) {
        button.addEventListener('click', closeConfirmModal);
    });

    document.addEventListener('keydown', function (event) {
        if (event.key === 'Escape' && confirmModal && !confirmModal.hidden) {
            closeConfirmModal();
        }
    });

    const highlightTarget = function (target) {
        if (!target) {
            return;
        }

        if (highlightedElement && highlightedElement !== target) {
            highlightedElement.classList.remove('quick-scroll-highlight');
        }

        target.classList.remove('quick-scroll-highlight');
        void target.offsetWidth;
        target.classList.add('quick-scroll-highlight');
        highlightedElement = target;

        if (highlightTimer) {
            window.clearTimeout(highlightTimer);
        }

        highlightTimer = window.setTimeout(function () {
            target.classList.remove('quick-scroll-highlight');
            if (highlightedElement === target) {
                highlightedElement = null;
            }
        }, 1100);
    };

    const highlightAfterArrival = function (target) {
        const finish = function () {
            window.removeEventListener('scrollend', finish);
            window.removeEventListener('scroll', onScroll);
            if (scrollStopTimer) {
                window.clearTimeout(scrollStopTimer);
                scrollStopTimer = null;
            }
            highlightTarget(target);
        };

        const onScroll = function () {
            if (scrollStopTimer) {
                window.clearTimeout(scrollStopTimer);
            }

            scrollStopTimer = window.setTimeout(finish, 120);
        };

        let scrollStopTimer = null;
        window.addEventListener('scrollend', finish, { once: true });
        window.addEventListener('scroll', onScroll);
        onScroll();
    };

    quickLinks.forEach(function (link) {
        link.addEventListener('click', function (event) {
            const href = link.getAttribute('href') || '';
            const targetId = href.startsWith('#') ? href.slice(1) : '';
            const target = targetId ? document.getElementById(targetId) : null;

            if (!target) {
                return;
            }

            event.preventDefault();
            target.scrollIntoView({ behavior: 'smooth', block: 'start' });
            window.history.replaceState(null, '', '#' + targetId);
            highlightAfterArrival(target);
        });
    });

    const bindAdminContentActions = function () {
        const form = document.querySelector('[data-admin-content-form]');

        if (form && !form.dataset.ajaxBound) {
            form.dataset.ajaxBound = 'true';
            if (form.dataset.adminContentNativeSubmit === 'true') {
                return;
            }
            form.addEventListener('submit', function (event) {
                event.preventDefault();
                submitAdminContentAction(form, '{{ ui.saving }}');
            });
        }

        document.querySelectorAll('[data-admin-content-action]').forEach(function (actionForm) {
            if (actionForm.dataset.ajaxBound) {
                return;
            }

            actionForm.dataset.ajaxBound = 'true';
            actionForm.addEventListener('submit', function (event) {
                event.preventDefault();
                if (actionForm.dataset.confirmMessage && openConfirmModal(actionForm)) {
                    return;
                }

                submitAdminContentAction(actionForm, '{{ ui.deleting }}');
            });
        });
    };

    bindAdminContentActions();
});
</script>
{% endblock %}
