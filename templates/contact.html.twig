{% extends "layout.html.twig" %}

{% block content %}

<section class="contact-hero">
    <h1>{{ trans('contact.title') }}</h1>
    <p>{{ trans('contact.subtitle') }}</p>
</section>

<section class="contact-container">
    <div class="contact-main-layout">
        <div class="contact-direct-card">
            <h2>{{ trans('contact.direct_title') }}</h2>
            <p>{{ trans('contact.direct_copy') }}</p>

            <div class="contact-direct-grid">
                <a class="contact-direct-item" href="tel:+15146681690">
                    <span class="contact-direct-icon" aria-hidden="true">
                        <svg viewBox="0 0 24 24" focusable="false">
                            <path d="M6.6 10.8a15.5 15.5 0 0 0 6.6 6.6l2.2-2.2a1.5 1.5 0 0 1 1.5-.37c1.16.39 2.4.6 3.67.6A1.4 1.4 0 0 1 22 16.85V20.6A1.4 1.4 0 0 1 20.6 22 18.6 18.6 0 0 1 2 3.4 1.4 1.4 0 0 1 3.4 2h3.75a1.4 1.4 0 0 1 1.4 1.43c0 1.27.2 2.5.6 3.67a1.5 1.5 0 0 1-.37 1.5z" />
                        </svg>
                    </span>
                    <span class="contact-direct-text">
                        <span class="contact-direct-label">{{ trans('contact.phone_label') }}</span>
                        <span class="contact-direct-value">+1 514-668-1690</span>
                    </span>
                </a>

                <a class="contact-direct-item" href="sms:+15146681690">
                    <span class="contact-direct-icon" aria-hidden="true">
                        <svg viewBox="0 0 24 24" focusable="false">
                            <path d="M4 4h16a2 2 0 0 1 2 2v9a2 2 0 0 1-2 2H8l-4 3v-3H4a2 2 0 0 1-2-2V6a2 2 0 0 1 2-2zm3.5 5.5h9a1 1 0 1 0 0-2h-9a1 1 0 1 0 0 2zm0 4h6a1 1 0 1 0 0-2h-6a1 1 0 1 0 0 2z" />
                        </svg>
                    </span>
                    <span class="contact-direct-text">
                        <span class="contact-direct-label">{{ trans('contact.text_label') }}</span>
                        <span class="contact-direct-value">+1 514-668-1690</span>
                    </span>
                </a>

                <a class="contact-direct-item" href="https://wa.me/15146681690" target="_blank" rel="noopener noreferrer">
                    <span class="contact-direct-icon" aria-hidden="true">
                        <svg viewBox="0 0 24 24" focusable="false">
                            <path d="M12.04 2C6.84 2 2.62 6.2 2.62 11.4c0 1.67.44 3.3 1.28 4.72L2.5 21.5l5.51-1.36a9.42 9.42 0 0 0 4.03.9h.01c5.2 0 9.42-4.21 9.42-9.42A9.42 9.42 0 0 0 12.04 2zm5.49 13.3c-.23.64-1.33 1.2-1.83 1.28-.47.07-1.06.1-1.72-.11-.4-.13-.9-.29-1.56-.58-2.74-1.18-4.52-4.07-4.66-4.26-.14-.19-1.12-1.49-1.12-2.85 0-1.35.7-2.01.95-2.29.26-.28.56-.35.75-.35h.54c.17 0 .4-.06.62.46.23.56.8 1.93.87 2.07.07.14.12.3.02.49-.09.19-.14.3-.28.46-.14.16-.29.35-.42.47-.14.14-.28.29-.12.58.16.28.72 1.18 1.55 1.91 1.07.95 1.97 1.24 2.25 1.39.28.14.45.12.61-.07.19-.23.78-.91.99-1.22.21-.31.42-.26.7-.16.28.09 1.79.85 2.1 1 .31.16.51.23.58.35.07.12.07.67-.16 1.31z" />
                        </svg>
                    </span>
                    <span class="contact-direct-text">
                        <span class="contact-direct-label">{{ trans('contact.whatsapp_label') }}</span>
                        <span class="contact-direct-value">+1 514-668-1690</span>
                    </span>
                </a>

                <a class="contact-direct-item" href="mailto:clemexique@gmail.com">
                    <span class="contact-direct-icon" aria-hidden="true">
                        <svg viewBox="0 0 24 24" focusable="false">
                            <path d="M3 5h18a2 2 0 0 1 2 2v10a2 2 0 0 1-2 2H3a2 2 0 0 1-2-2V7a2 2 0 0 1 2-2zm0 2v.2l9 5.63 9-5.63V7H3zm18 10V9.57l-8.47 5.3a1 1 0 0 1-1.06 0L3 9.57V17h18z" />
                        </svg>
                    </span>
                    <span class="contact-direct-text">
                        <span class="contact-direct-label">{{ trans('contact.email_label') }}</span>
                        <span class="contact-direct-value">clemexique@gmail.com</span>
                    </span>
                </a>

                <a class="contact-direct-item" href="https://www.facebook.com/profile.php?id=61592811254307" target="_blank" rel="noopener noreferrer">
                    <span class="contact-direct-icon" aria-hidden="true">
                        <svg viewBox="0 0 24 24" focusable="false">
                            <path d="M13.5 22v-8.2h2.77l.42-3.23H13.5V8.5c0-.94.26-1.58 1.6-1.58h1.7V4.03c-.3-.04-1.33-.13-2.52-.13-2.5 0-4.22 1.53-4.22 4.35v2.3H7.2v3.23h2.86V22h3.44z" />
                        </svg>
                    </span>
                    <span class="contact-direct-text">
                        <span class="contact-direct-label">{{ trans('contact.facebook_label') }}</span>
                        <span class="contact-direct-value">facebook.com/profile.php?id=61592811254307</span>
                    </span>
                </a>
            </div>
        </div>

        <div class="contact-form-shell">
            {% if success %}
                <div class="form-success">
                    {{ trans('contact.success') }}
                </div>
            {% endif %}

            {% if error %}
                <div class="form-error">
                    {{ error }}
                </div>
            {% endif %}

            <form id="contact-form" class="contact-form" method="POST" action="{{ base_path }}/contact">
                <input type="hidden" name="preferred_language" value="{{ app_lang }}">

                <div class="form-group">
                    <label>{{ trans('contact.name') }}</label>
                    <input type="text" name="name" value="{{ name }}" required>
                </div>

                <div class="contact-form-row">
                    <div class="form-group">
                        <label>{{ trans('contact.email') }}</label>
                        <input type="email" name="email" value="{{ email }}" required>
                    </div>

                    <div class="form-group">
                        <label>{{ trans('contact.phone') }}</label>
                        <input type="text" name="phone" value="{{ phone }}">
                    </div>
                </div>

                <div class="form-group">
                    <label>{{ trans('contact.project') }}</label>
                    <input type="text" name="project" value="{{ project }}">
                </div>

                <div class="form-group">
                    <label>{{ trans('contact.subject') }}</label>
                    <input type="text" name="subject" value="{{ subject }}">
                </div>

                <div class="form-group">
                    <label>{{ trans('contact.message') }}</label>
                    <textarea name="message" rows="4" required>{{ message }}</textarea>
                </div>

                <div class="form-group">
                    {% if recaptcha_site_key %}
                        <div id="contact-recaptcha"></div>
                    {% else %}
                        <p class="form-error-inline">{{ trans('contact.error_captcha_unavailable') }}</p>
                    {% endif %}
                </div>

                <button type="submit" class="contact-btn" data-contact-submit>
                    {{ trans('contact.submit') }}
                </button>
            </form>
        </div>
    </div>

    <div class="page-home-actions">
        <a href="{{ base_path }}/?lang={{ app_lang }}" class="info-request-link">{{ trans('common.back_home') }}</a>
    </div>

</section>

{% endblock %}

{% block scripts %}
    {% if recaptcha_site_key %}
        <script>
        window.contactRecaptchaWidgetId = null;
        window.contactRecaptchaSubmitting = false;

        window.onContactRecaptchaSubmit = function () {
            const form = document.getElementById('contact-form');

            if (!form) {
                return;
            }

            window.contactRecaptchaSubmitting = true;
            form.submit();
        };

        window.onContactRecaptchaExpired = function () {
            window.contactRecaptchaSubmitting = false;
        };

        window.onContactRecaptchaLoad = function () {
            const container = document.getElementById('contact-recaptcha');

            if (!container || typeof grecaptcha === 'undefined') {
                return;
            }

            window.contactRecaptchaWidgetId = grecaptcha.render(container, {
                sitekey: '{{ recaptcha_site_key }}',
                size: 'invisible',
                callback: window.onContactRecaptchaSubmit,
                'expired-callback': window.onContactRecaptchaExpired
            });
        };

        document.addEventListener('DOMContentLoaded', function () {
            const form = document.getElementById('contact-form');

            if (!form) {
                return;
            }

            form.addEventListener('submit', function (event) {
                if (window.contactRecaptchaSubmitting) {
                    return;
                }

                if (!form.reportValidity()) {
                    event.preventDefault();
                    return;
                }

                if (window.contactRecaptchaWidgetId === null || typeof grecaptcha === 'undefined') {
                    return;
                }

                event.preventDefault();
                grecaptcha.execute(window.contactRecaptchaWidgetId);
            });
        });
        </script>
        <script src="https://www.google.com/recaptcha/api.js?onload=onContactRecaptchaLoad&render=explicit&hl={{ app_lang }}" async defer></script>
    {% endif %}
{% endblock %}
