{% extends "layout.html.twig" %}

{% block content %}
<section class="about-hero">
    <p>{{ hero_text }}</p>
</section>

<section class="residency-container">
    <h1>{{ title_text }}</h1>
    <p>{{ intro_text }}</p>

    <div class="residency-note">
        <p>{{ section_copy }}</p>
        <p>{{ discount_note }}</p>

        <div class="page-home-actions">
            <a href="https://www.bluecaribetours.com/" class="info-request-link" target="_blank" rel="noopener noreferrer">{{ redirect_cta }}</a>
        </div>
    </div>

    <div class="page-home-actions">
        <a href="{{ base_path }}/?lang={{ app_lang }}" class="info-request-link page-home-link">{{ trans('common.back_home') }}</a>
    </div>
</section>
{% endblock %}

