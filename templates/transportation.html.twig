{% extends "layout.html.twig" %}

{% block content %}
<section class="about-hero">
    <p>{{ hero_text }}</p>
</section>

<section class="residency-container restaurant-page-shell">
    <h1>{{ title_text }}</h1>
    <p>{{ intro_text }}</p>

    {% if transport_categories is empty %}
        <div class="residency-note">
            <h2>{{ section_title }}</h2>
            <p>{{ section_copy }}</p>
        </div>
    {% else %}
        <div class="restaurant-category-list">
            {% for category in transport_categories %}
                <section class="restaurant-category" id="transport-category-{{ loop.index }}">
                    <div class="restaurant-category-header">
                        <div class="restaurant-category-heading">
                            {% if category.flag %}
                                <span class="restaurant-category-heading-icon">{{ render_category_icon(category.flag) }}</span>
                            {% endif %}
                            <h2>{{ category.title }}</h2>
                        </div>
                        <span>
                            {{ category.items|length }}
                            {{ app_lang == 'fr'
                                ? (category.items|length == 1 ? 'service' : 'services')
                                : (app_lang == 'es'
                                    ? (category.items|length == 1 ? 'servicio' : 'servicios')
                                    : (category.items|length == 1 ? 'service' : 'services')) }}
                        </span>
                    </div>

                    <div class="guide-grid">
                        {% for item in category.items %}
                            <article class="guide-card">
                                <div class="guide-card-top">
                                    <h3>{{ item.name }}</h3>
                                </div>

                                {% if item.area %}
                                    <p class="guide-area">{{ item.area }}</p>
                                {% endif %}

                                {% if item.note %}
                                    <p class="guide-note">{{ item.note }}</p>
                                {% endif %}

                                {% if item.url %}
                                    <a href="{{ item.url }}" class="guide-link" target="_blank" rel="noopener noreferrer">
                                        {{ item.url_label ? item.url_label : item.url }}
                                    </a>
                                {% endif %}
                            </article>
                        {% endfor %}
                    </div>
                </section>
            {% endfor %}
        </div>
    {% endif %}

    <div class="page-home-actions">
        <a href="{{ base_path }}/?lang={{ app_lang }}" class="info-request-link page-home-link">{{ trans('common.back_home') }}</a>
    </div>
</section>
{% endblock %}
