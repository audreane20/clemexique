{% extends "layout.html.twig" %}

{% block content %}
<section class="home-toc-shell">
    <div class="home-toc-card">
        <div class="home-toc-copy">
            <p class="home-toc-eyebrow">{{ trans('home.toc_eyebrow') }}</p>
            <h2>{{ trans('home.toc_title') }}</h2>
            <p>{{ trans('home.toc_copy') }}</p>
        </div>

        <div class="home-toc-grid">
            <a href="#home-properties" class="home-toc-link" data-home-toc-target="home-properties">
                <span class="home-toc-link-title">{{ trans('home.toc_properties_title') }}</span>
                <span class="home-toc-link-copy">{{ trans('home.toc_properties_copy') }}</span>
            </a>
            <a href="#home-info-request" class="home-toc-link" data-home-toc-target="home-info-request">
                <span class="home-toc-link-title">{{ trans('home.toc_info_title') }}</span>
                <span class="home-toc-link-copy">{{ trans('home.toc_info_copy') }}</span>
            </a>
            <a href="#home-residency" class="home-toc-link" data-home-toc-target="home-residency">
                <span class="home-toc-link-title">{{ trans('home.toc_residency_title') }}</span>
                <span class="home-toc-link-copy">{{ trans('home.toc_residency_copy') }}</span>
            </a>
            <a href="#home-rental" class="home-toc-link" data-home-toc-target="home-rental">
                <span class="home-toc-link-title">{{ trans('home.toc_rental_title') }}</span>
                <span class="home-toc-link-copy">{{ trans('home.toc_rental_copy') }}</span>
            </a>
            <a href="#home-management" class="home-toc-link" data-home-toc-target="home-management">
                <span class="home-toc-link-title">{{ trans('home.toc_management_title') }}</span>
                <span class="home-toc-link-copy">{{ trans('home.toc_management_copy') }}</span>
            </a>
        </div>
    </div>
</section>

<section class="property-public-shell" id="home-properties">
    <div class="property-public-header">
        <h1>{{ trans('properties.title') }}</h1>
    </div>

    <div class="property-filter-bar">
        <span class="property-filter-label">{{ trans('properties.filter_label') }}</span>
        <div class="property-filter-actions">
            <a href="{{ base_path }}/?lang={{ app_lang }}&mode=all" class="property-filter-link {{ selected_mode == 'all' ? 'active' : '' }}">
                {{ trans('properties.filter_all') }}
            </a>
            <a href="{{ base_path }}/?lang={{ app_lang }}&mode=achat" class="property-filter-link {{ selected_mode == 'achat' ? 'active' : '' }}">
                {{ trans('properties.mode_buy') }}
            </a>
            <a href="{{ base_path }}/?lang={{ app_lang }}&mode=location" class="property-filter-link {{ selected_mode == 'location' ? 'active' : '' }}">
                {{ trans('properties.mode_rent') }}
            </a>
        </div>
    </div>

    {% if properties is empty %}
        <div class="property-empty-state property-empty-state-public">
            <p>{{ trans('properties.empty') }}</p>
        </div>
    {% else %}
        <div class="property-public-grid">
            {% for property in properties %}
                <article class="property-public-card">
                    <img src="{{ property.image_url }}" alt="{{ property.name }}" class="property-public-image">

                    <p class="property-public-mode">{{ property.listing_mode == 'location' ? trans('properties.mode_rent') : trans('properties.mode_buy') }}</p>
                    <h2>{{ property.name }}</h2>
                    <p class="property-public-city">{{ property.city }}</p>
                    <p class="property-public-price property-public-price-primary">{{ property.primary_price_display }}</p>
                    <p class="property-public-price property-public-price-secondary">{{ property.secondary_price_display }}</p>

                    <a href="{{ base_path ~ property.detail_url ~ '?lang=' ~ app_lang }}" class="property-public-link">
                        {{ trans('properties.cta') }}
                    </a>
                </article>
            {% endfor %}
        </div>
    {% endif %}
</section>

<section class="info-request-shell" id="home-info-request">
    <div class="info-request-card">
        <h2>{{ trans('info_request.title') }}</h2>
        <p class="info-request-copy">{{ trans('info_request.copy') }}</p>
        <div class="info-request-actions">
            <a href="{{ base_path }}/demande-information?lang={{ app_lang }}" class="info-request-link">{{ trans('info_request.cta') }}</a>
        </div>
    </div>
</section>

<section class="info-request-shell info-request-shell-secondary" id="home-residency">
    <div class="info-request-card info-request-card-compact">
        <h2 class="info-request-secondary-title">{{ trans('info_request.secondary_title') }}</h2>
        <p class="info-request-copy">{{ trans('info_request.secondary_copy') }}</p>
        <div class="info-request-actions">
            <a href="{{ base_path }}/residence-immigration?lang={{ app_lang }}" class="info-request-link">{{ trans('info_request.secondary_cta') }}</a>
        </div>
    </div>
</section>

<section class="info-request-shell info-request-shell-secondary" id="home-rental">
    <div class="info-request-card info-request-card-compact">
        <h2 class="info-request-secondary-title">{{ trans('auto_rental.title') }}</h2>
        <p class="info-request-copy">{{ trans('auto_rental.copy') }}</p>
        <div class="info-request-actions">
            <a href="{{ base_path }}/location-automobiles?lang={{ app_lang }}" class="info-request-link">{{ trans('auto_rental.home_cta') }}</a>
        </div>
    </div>
</section>

<section class="info-request-shell info-request-shell-secondary" id="home-management">
    <div class="info-request-card info-request-card-compact">
        <h2 class="info-request-secondary-title">{{ trans('property_management.title') }}</h2>
        <p class="info-request-copy">{{ trans('property_management.copy') }}</p>
        <div class="info-request-actions">
            <a href="{{ base_path }}/gestion-immobiliere?lang={{ app_lang }}" class="info-request-link">{{ trans('property_management.home_cta') }}</a>
        </div>
    </div>
</section>

<script>
document.addEventListener('DOMContentLoaded', function () {
    const tocLinks = document.querySelectorAll('[data-home-toc-target]');

    tocLinks.forEach(function (link) {
        link.addEventListener('click', function (event) {
            const targetId = link.getAttribute('data-home-toc-target');
            const target = targetId ? document.getElementById(targetId) : null;

            if (!target) {
                return;
            }

            event.preventDefault();

            const header = document.querySelector('.site-header');
            const headerHeight = header ? header.offsetHeight : 0;
            const rect = target.getBoundingClientRect();
            const targetTop = window.scrollY + rect.top;
            const centeredOffset = Math.max(80, (window.innerHeight - rect.height) / 2);
            const scrollTop = Math.max(0, targetTop - centeredOffset - (headerHeight / 2));

            window.history.replaceState(null, '', '#' + targetId);
            window.scrollTo({
                top: scrollTop,
                behavior: 'smooth'
            });
        });
    });
});
</script>
{% endblock %}
