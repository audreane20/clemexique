<!DOCTYPE html>
<html lang="{{ app_lang ?? 'fr' }}">
<head>
    <link rel="icon" type="image/png" href="{{ base_path }}/images/Circle_logo-cropped.png" />
    <meta charset="UTF-8">
    <title>{% if page_title_key is defined %}{{ trans(page_title_key) }}{% else %}{{ page_title ?? 'Riviera Maya' }}{% endif %}</title>
    <meta name="viewport" content="width=device-width, initial-scale=1.0">

    <link rel="stylesheet" href="{{ base_path }}/css/style.css">
</head>
<body class="{{ body_class ?? '' }}">

{% if not (hide_site_header ?? false) %}
<header class="site-header">
    <div class="header-container">
        <div class="header-left">
            <a href="{{ base_path }}/" class="logo">
                <img src="{{ base_path }}/images/logo_t.png" alt="Riviera Maya Logo">
            </a>
        </div>

        <button
            type="button"
            class="header-menu-toggle"
            data-header-menu-toggle
            aria-expanded="false"
            aria-controls="site-header-menu"
            aria-label="{{ app_lang == 'fr' ? 'Ouvrir le menu' : (app_lang == 'es' ? 'Abrir menu' : 'Open menu') }}"
        >
            <span class="header-menu-toggle-line" aria-hidden="true"></span>
            <span class="header-menu-toggle-line" aria-hidden="true"></span>
            <span class="header-menu-toggle-line" aria-hidden="true"></span>
        </button>

        <button type="button" class="header-menu-backdrop" data-header-menu-close hidden aria-label="{{ app_lang == 'fr' ? 'Fermer le menu' : (app_lang == 'es' ? 'Cerrar menu' : 'Close menu') }}"></button>

        <div class="header-menu-panel" id="site-header-menu" data-header-menu-panel hidden>
            <nav class="main-nav">
                <a href="{{ base_path }}/">{{ trans('nav.home') }}</a>
                <a href="{{ base_path }}/about">{{ trans('nav.about') }}</a>
                <a href="{{ base_path }}/contact">{{ trans('nav.contact') }}</a>
            </nav>

            <div class="header-right">
                {% if is_admin_authenticated %}
                    <div class="header-auth-actions">
                        <details class="account-menu header-admin-menu">
                            <summary class="header-auth-link admin-shortcuts-trigger">
                                {{ app_lang == 'fr' ? 'Gérer le contenu' : (app_lang == 'es' ? 'Gestionar contenido' : 'Manage content') }}
                            </summary>

                            <div class="account-menu-panel">
                                <a href="{{ base_path }}/admin/properties?lang={{ app_lang }}" class="account-menu-link">{{ app_lang == 'fr' ? 'Propriétés' : (app_lang == 'es' ? 'Propiedades' : 'Properties') }}</a>
                                <a href="{{ base_path }}/admin/content/restaurants?lang={{ app_lang }}" class="account-menu-link">{{ app_lang == 'es' ? 'Restaurantes' : 'Restaurants' }}</a>
                                <a href="{{ base_path }}/admin/content/excursions?lang={{ app_lang }}" class="account-menu-link">{{ app_lang == 'es' ? 'Excursiones' : 'Excursions' }}</a>
                                <a href="{{ base_path }}/admin/content/playa_guide?lang={{ app_lang }}" class="account-menu-link">{{ app_lang == 'fr' ? 'Quoi faire à Playa' : (app_lang == 'es' ? 'Que hacer en Playa' : 'Things to do') }}</a>
                            </div>
                        </details>
                    </div>
                {% endif %}

                <div class="header-auth-actions">
                    {% if is_admin_authenticated %}
                        <details class="account-menu">
                            <summary class="user-chip">
                                <span class="user-chip-label">
                                    {{ trans('auth.hello') }}
                                    {{ admin_username }}
                                </span>
                                <span class="user-chip-toggle" aria-hidden="true">
                                    <svg viewBox="0 0 16 16" focusable="false">
                                        <path d="M4 6.5 8 10.5 12 6.5" />
                                    </svg>
                                </span>
                            </summary>

                            <div class="account-menu-panel">
                                <a href="{{ base_path ~ '/admin/profile' }}" class="account-menu-link">{{ trans('nav.edit_profile') }}</a>

                                <form method="POST" action="{{ base_path }}/account/logout" class="account-menu-form">
                                    <button type="submit" class="account-menu-button">{{ trans('nav.logout') }}</button>
                                </form>
                            </div>
                        </details>
                    {% endif %}
                </div>

                <div class="header-lang-group">
                    <div class="lang-switch">
                        <a href="?lang=en" class="{{ app_lang == 'en' ? 'active' : '' }}">EN</a>
                        <span class="lang-divider">|</span>
                        <a href="?lang=es" class="{{ app_lang == 'es' ? 'active' : '' }}">ES</a>
                        <span class="lang-divider">|</span>
                        <a href="?lang=fr" class="{{ app_lang == 'fr' ? 'active' : '' }}">FR</a>
                    </div>
                </div>
            </div>
        </div>

    </div>
</header>
{% endif %}

<main class="page-content">
    {% block content %}{% endblock %}
</main>

<script>
document.addEventListener('DOMContentLoaded', function () {
    const toggle = document.querySelector('[data-header-menu-toggle]');
    const panel = document.querySelector('[data-header-menu-panel]');
    const backdrop = document.querySelector('[data-header-menu-close]');
    const adminShortcutSequence = ['1', '6', '9', '0'];
    const adminShortcutPin = adminShortcutSequence.join('');
    let adminShortcutBuffer = [];

    if (!toggle || !panel) {
        return;
    }

    const setMenuState = function (isOpen) {
        toggle.classList.toggle('is-open', isOpen);
        toggle.setAttribute('aria-expanded', isOpen ? 'true' : 'false');
        panel.hidden = !isOpen;

        if (backdrop) {
            backdrop.hidden = !isOpen;
        }

        document.body.classList.toggle('mobile-menu-open', isOpen && window.innerWidth <= 768);
    };

    const syncDesktopState = function () {
        if (window.innerWidth > 768) {
            panel.hidden = false;
            if (backdrop) {
                backdrop.hidden = true;
            }
            toggle.setAttribute('aria-expanded', 'false');
            toggle.classList.remove('is-open');
            document.body.classList.remove('mobile-menu-open');
            return;
        }

        if (!toggle.classList.contains('is-open')) {
            panel.hidden = true;
            if (backdrop) {
                backdrop.hidden = true;
            }
        }
    };

    toggle.addEventListener('click', function () {
        setMenuState(!toggle.classList.contains('is-open'));
    });

    if (backdrop) {
        backdrop.addEventListener('click', function () {
            setMenuState(false);
        });
    }

    const submitAdminShortcut = function () {
        const form = document.createElement('form');
        const pinField = document.createElement('input');

        form.method = 'POST';
        form.action = '{{ base_path }}/admin/login';
        form.hidden = true;

        pinField.type = 'hidden';
        pinField.name = 'pin';
        pinField.value = adminShortcutPin;

        form.appendChild(pinField);
        document.body.appendChild(form);
        form.submit();
    };

    window.addEventListener('resize', syncDesktopState);
    syncDesktopState();

    document.addEventListener('keydown', function (event) {
        const target = event.target;
        const isTypingField = target instanceof HTMLElement && (
            target.tagName === 'INPUT' ||
            target.tagName === 'TEXTAREA' ||
            target.tagName === 'SELECT' ||
            target.isContentEditable
        );

        if (isTypingField || event.ctrlKey || event.metaKey || event.altKey) {
            adminShortcutBuffer = [];
            return;
        }

        const key = (event.key || '').toLowerCase();

        if (!/^[0-9]$/.test(key)) {
            adminShortcutBuffer = [];
            return;
        }

        adminShortcutBuffer.push(key);

        if (adminShortcutBuffer.length > adminShortcutSequence.length) {
            adminShortcutBuffer.shift();
        }

        const matchesShortcut = adminShortcutSequence.every(function (shortcutKey, index) {
            return adminShortcutBuffer[index] === shortcutKey;
        });

        if (matchesShortcut) {
            adminShortcutBuffer = [];
            submitAdminShortcut();
        }
    });
});
</script>

{% block scripts %}{% endblock %}

</body>
</html>
