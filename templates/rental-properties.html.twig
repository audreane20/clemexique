{% extends "layout.html.twig" %}

{% block content %}
<section class="about-hero">
    <p>{{ trans('info_request_rent.hero') }}</p>
</section>

<section class="residency-container">
    <h1>{{ trans('info_request_rent.title') }}</h1>
    <p>{{ trans('info_request_rent.copy') }}</p>

    <div class="residency-note">
        <p>
            <strong>
                {{ trans('info_request_rent.note_line_1') }}<br>
                {{ trans('info_request_rent.note_line_2') }}
