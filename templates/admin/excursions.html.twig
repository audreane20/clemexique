{% extends "layout.html.twig" %}

{% block content %}
{% set price_options = ['$', '$$', '$$$', '$$$$', '$$$$$'] %}
{% set is_restaurants = active_section == 'restaurants' %}
{% set item_label = active_section == 'restaurants'
    ? {'en': 'restaurant', 'fr': 'restaurant', 'es': 'restaurante'}
    : active_section == 'excursions'
        ? {'en': 'excursion', 'fr': 'excursion', 'es': 'excursion'}
        : {'en': 'activity', 'fr': 'activite', 'es': 'actividad'} %}
{% set ui = {
    'en': {
        'eyebrow': 'Admin',
        'edit': 'Edit',
        'add_restaurant': 'Add a restaurant',
        'add_excursion': 'Add an excursion',
        'add_activity': 'Add an activity',
        'editing_copy': 'The selected %s is loaded here for editing.',
        'create_copy': 'Choose an existing category or create a new one directly from this form.',
        'cancel': 'Cancel',
        'category': 'Category',
        'select_category': 'Select a category',
        'new_category': 'New category',
        'new_category_copy': 'This category will be created when you save the %s.',
        'search_icon': 'Search by name or code',
        'no_matching_icons': 'No matching icons.',
        'preview': 'Preview:',
        'no_icon': 'No icon selected yet',
        'unknown_code': 'Unknown code',
        'optional': 'optional',
        'select_price': 'Select a price range',
        'favorite_pick': 'Favorite pick',
        'select_reference': 'Select a reference',
        'no_reference': 'No reference',
        'save': 'Save %s',
        'add': 'Add %s',
        'current_sections': 'Current sections',
        'categories': 'categories',
        'no_categories': 'No categories yet.',
        'items': 'items',
        'delete_category_confirm': 'Delete this category?',
        'delete': 'Delete',
        'empty_restaurants': 'No restaurants in this category yet.',
        'empty_items': 'No items in this category yet.',
        'delete_item_confirm': 'Delete this item?',
        'saving': 'Saving...',
        'deleting': 'Deleting...'
    },
    'fr': {
        'eyebrow': 'Admin',
        'edit': 'Modifier',
        'add_restaurant': 'Ajouter un restaurant',
        'add_excursion': 'Ajouter une excursion',
        'add_activity': 'Ajouter une activite',
        'editing_copy': 'L element selectionne est charge ici pour modification.',
        'create_copy': 'Choisissez une categorie existante ou creez-en une nouvelle directement depuis ce formulaire.',
        'cancel': 'Annuler',
        'category': 'Categorie',
        'select_category': 'Selectionnez une categorie',
        'new_category': 'Nouvelle categorie',
        'new_category_copy': 'Cette categorie sera creee lorsque vous enregistrerez %s.',
        'search_icon': 'Recherchez par nom ou code',
        'no_matching_icons': 'Aucune icone correspondante.',
        'preview': 'Apercu :',
        'no_icon': 'Aucune icone selectionnee pour le moment',
        'unknown_code': 'Code inconnu',
        'optional': 'optionnel',
        'select_price': 'Selectionnez une gamme de prix',
        'favorite_pick': 'Coup de coeur',
        'select_reference': 'Selectionnez une reference',
        'no_reference': 'Aucune reference',
        'save': 'Enregistrer %s',
        'add': 'Ajouter %s',
        'current_sections': 'Sections actuelles',
        'categories': 'categories',
        'no_categories': 'Aucune categorie pour le moment.',
        'items': 'elements',
        'delete_category_confirm': 'Supprimer cette categorie ?',
        'delete': 'Supprimer',
        'empty_restaurants': 'Aucun restaurant dans cette categorie pour le moment.',
        'empty_items': 'Aucun element dans cette categorie pour le moment.',
        'delete_item_confirm': 'Supprimer cet element ?',
        'saving': 'Enregistrement...',
        'deleting': 'Suppression...'
    },
    'es': {
        'eyebrow': 'Admin',
        'edit': 'Editar',
        'add_restaurant': 'Agregar un restaurante',
        'add_excursion': 'Agregar una excursion',
        'add_activity': 'Agregar una actividad',
        'editing_copy': 'El elemento seleccionado esta cargado aqui para editarlo.',
        'create_copy': 'Elige una categoria existente o crea una nueva directamente desde este formulario.',
        'cancel': 'Cancelar',
        'category': 'Categoria',
        'select_category': 'Selecciona una categoria',
        'new_category': 'Nueva categoria',
        'new_category_copy': 'Esta categoria se creara cuando guardes %s.',
        'search_icon': 'Busca por nombre o codigo',
        'no_matching_icons': 'No hay iconos coincidentes.',
        'preview': 'Vista previa:',
        'no_icon': 'Todavia no hay icono seleccionado',
        'unknown_code': 'Codigo desconocido',
        'optional': 'opcional',
        'select_price': 'Selecciona un rango de precio',
        'favorite_pick': 'Favorito',
        'select_reference': 'Selecciona una referencia',
        'no_reference': 'Sin referencia',
        'save': 'Guardar %s',
        'add': 'Agregar %s',
        'current_sections': 'Secciones actuales',
        'categories': 'categorias',
        'no_categories': 'Todavia no hay categorias.',
        'items': 'elementos',
        'delete_category_confirm': '¿Eliminar esta categoría?',
        'delete': 'Eliminar',
        'empty_restaurants': 'Todavia no hay restaurantes en esta categoria.',
        'empty_items': 'Todavia no hay elementos en esta categoria.',
        'delete_item_confirm': '¿Eliminar este elemento?',
        'saving': 'Guardando...',
        'deleting': 'Eliminando...'
    }
} %}
{% set current_item_label = item_label[app_lang] %}
{% set add_title = is_restaurants ? ui[app_lang].add_restaurant : (active_section == 'excursions' ? ui[app_lang].add_excursion : ui[app_lang].add_activity) %}
{% set required_item_fields = is_restaurants ? ['name', 'area', 'price', 'url'] : ['name', 'area', 'url'] %}
{% set optional_item_fields = is_restaurants ? ['reference'] : ['note', 'video_url'] %}
{% set is_editing_item = editing_item is not null %}
{% set item_form_action = is_editing_item ? base_path ~ '/admin/content/' ~ active_section ~ '/items/' ~ editing_item_category_index ~ '/' ~ editing_item_index ~ '/update' : base_path ~ '/admin/content/' ~ active_section ~ '/items/create' %}
{% set selected_category_choice = is_editing_item ? editing_item_category_index : '' %}
<section class="admin-content-shell">
    <div class="admin-properties-header">
        <div>
            <p class="admin-properties-eyebrow">{{ ui[app_lang].eyebrow }}</p>
            <h1>{{ section_config.page_title[app_lang] }}</h1>
            <p>{{ section_config.page_copy[app_lang] }}</p>
        </div>
    </div>

    {% if flash_success %}
        <div class="form-success">{{ flash_success }}</div>
    {% endif %}

    {% if flash_error %}
        <div class="form-error">{{ flash_error }}</div>
    {% endif %}

    <div class="admin-content-layout">
        <section class="admin-content-card admin-content-create-card">
            <div class="admin-content-form-header">
                <div>
                    <h2>
                        {% if is_editing_item %}
                            {{ ui[app_lang].edit ~ ' ' ~ current_item_label }}
                        {% else %}
                            {{ add_title }}
                        {% endif %}
                    </h2>
                    <p>
                        {% if is_editing_item %}
                            {{ ui[app_lang].editing_copy|format(current_item_label) }}
                        {% else %}
                            {{ ui[app_lang].create_copy }}
                        {% endif %}
                    </p>
                </div>
                {% if is_editing_item %}
                    <a href="{{ base_path }}/admin/content/{{ active_section }}?lang={{ editor_language }}" class="admin-content-cancel-link">{{ ui[app_lang].cancel }}</a>
                {% endif %}
            </div>

            <form method="POST" action="{{ item_form_action }}" class="admin-content-form" data-admin-content-form>
                <input type="hidden" name="editor_language" value="{{ editor_language }}">

                <label>
                    <span class="admin-content-label-copy">{{ ui[app_lang].category }}<span class="admin-content-required-marker">*</span></span>
                    <select name="category_choice" data-category-choice>
                        <option value="">{{ ui[app_lang].select_category }}</option>
                        {% for category in categories %}
                            <option value="{{ loop.index0 }}" {{ selected_category_choice == loop.index0 ? 'selected' : '' }}>
                                {{ category.title }}
                            </option>
                        {% endfor %}
                        <option value="__new__">{{ ui[app_lang].new_category }}</option>
                    </select>
                </label>

                <div class="admin-content-new-category-fields is-hidden" data-new-category-fields>
                    <div class="admin-content-inline-title">
                        <h3>{{ ui[app_lang].new_category }}</h3>
                        <p>{{ ui[app_lang].new_category_copy|format(current_item_label) }}</p>
                    </div>

                    {% for field in section_config.category_fields %}
                        <label>
                            {{ field.labels[app_lang] }}
                            {% if field.name == 'flag' %}
                                <div class="admin-content-icon-picker" data-category-icon-picker>
                                    <input type="hidden" name="new_category_{{ field.name }}" value="" data-category-icon-value>
                                    <input type="text" value="" placeholder="{{ ui[app_lang].search_icon }}" autocomplete="off" data-category-icon-input>
                                    <div class="admin-content-icon-picker-menu is-hidden" data-category-icon-menu>
                                        {% for choice in category_icon_choices %}
                                            <button type="button" class="admin-content-icon-option" data-icon-code="{{ choice.code }}" data-icon-label="{{ choice.name }}">
                                                <span class="admin-content-icon-option-symbol">{{ render_category_icon(choice.code) }}</span>
                                                <span class="admin-content-icon-option-copy">
                                                    <strong>{{ choice.name }}</strong>
                                                    <span>{{ choice.code }}</span>
                                                </span>
                                            </button>
                                        {% endfor %}
                                        <div class="admin-content-icon-empty is-hidden" data-category-icon-empty>
                                            {{ ui[app_lang].no_matching_icons }}
                                        </div>
                                    </div>
                                </div>
                                <div class="admin-content-icon-preview" data-category-icon-preview>
                                    <span class="admin-content-icon-preview-label">{{ ui[app_lang].preview }}</span>
                                    <span class="admin-content-icon-preview-value">{{ ui[app_lang].no_icon }}</span>
                                </div>
                            {% else %}
                                <input type="text" name="new_category_{{ field.name }}" value="" placeholder="{{ field.placeholders[app_lang] }}">
                            {% endif %}
                        </label>
                    {% endfor %}
                </div>

                {% for field in section_config.item_fields %}
                    {% if field.name != 'url_label' %}
                    <label>
                        <span class="admin-content-label-copy">
                            {{ field.labels[app_lang] }}
                            {% if field.name in required_item_fields %}
                                <span class="admin-content-required-marker">*</span>
                            {% elseif field.name in optional_item_fields %}
                                <span class="admin-content-optional-marker">({{ ui[app_lang].optional }})</span>
                            {% endif %}
                        </span>
                        {% if is_restaurants and field.name == 'price' %}
                            <select name="{{ field.name }}">
                                <option value="">{{ ui[app_lang].select_price }}</option>
                                {% for option in price_options %}
                                    <option value="{{ option }}" {{ is_editing_item and attribute(editing_item, field.name)|default('') == option ? 'selected' : '' }}>{{ option }}</option>
                                {% endfor %}
                            </select>
                        {% elseif is_restaurants and field.name == 'reference' %}
                            {% set current_reference = is_editing_item ? attribute(editing_item, field.name)|default('') : '' %}
                            {% set current_reference_lower = current_reference|lower %}
                            {% set favorite_reference_value = ui[app_lang].favorite_pick %}
                            {% set tripadvisor_reference_value = 'Tripadvisor 2025' %}
                            {% set selected_reference_value = '' %}
                            {% if 'tripadvisor' in current_reference_lower %}
                                {% set selected_reference_value = tripadvisor_reference_value %}
                            {% elseif 'favorite pick' in current_reference_lower or 'coup de coeur' in current_reference_lower or 'coup de cÅ“ur' in current_reference_lower %}
                                {% set selected_reference_value = favorite_reference_value %}
                            {% endif %}

                            <div class="admin-content-reference-picker" data-reference-picker>
                                <input type="hidden" name="{{ field.name }}" value="{{ selected_reference_value }}" data-reference-value>
                                <button type="button" class="admin-content-reference-trigger" data-reference-trigger aria-haspopup="listbox" aria-expanded="false">
                                    <span class="admin-content-reference-trigger-content" data-reference-trigger-content>
                                        {% if selected_reference_value == favorite_reference_value %}
                                            <span class="restaurant-reference-badge restaurant-reference-badge-heart">
                                                <span class="restaurant-reference-heart" aria-hidden="true">&#10084;</span>
                                                <span>{{ favorite_reference_value }}</span>
                                            </span>
                                        {% elseif selected_reference_value == tripadvisor_reference_value %}
                                            <span class="admin-content-reference-choice-render">
                                                <span class="restaurant-reference-badge restaurant-reference-badge-tripadvisor">
                                                    <img src="{{ base_path }}/Images/tripadvisor_logo.webp" alt="Tripadvisor Travelers' Choice Awards 2025" class="restaurant-reference-tripadvisor-logo">
                                                </span>
                                                <span class="admin-content-reference-choice-label">{{ tripadvisor_reference_value }}</span>
                                            </span>
                                        {% else %}
                                            <span class="admin-content-reference-placeholder">{{ ui[app_lang].select_reference }}</span>
                                        {% endif %}
                                    </span>
                                </button>

                                <div class="admin-content-reference-menu is-hidden" data-reference-menu role="listbox">
                                    <button type="button" class="admin-content-reference-option" data-reference-option data-reference-value="">
                                        <span class="admin-content-reference-choice-render">
                                            <span class="admin-content-reference-placeholder">{{ ui[app_lang].no_reference }}</span>
                                        </span>
                                    </button>

                                    <button type="button" class="admin-content-reference-option" data-reference-option data-reference-value="{{ favorite_reference_value }}">
                                        <span class="admin-content-reference-choice-render">
                                            <span class="restaurant-reference-badge restaurant-reference-badge-heart">
                                                <span class="restaurant-reference-heart" aria-hidden="true">&#10084;</span>
                                                <span>{{ favorite_reference_value }}</span>
                                            </span>
                                        </span>
                                    </button>

                                    <button type="button" class="admin-content-reference-option" data-reference-option data-reference-value="{{ tripadvisor_reference_value }}">
                                        <span class="admin-content-reference-choice-render">
                                            <span class="restaurant-reference-badge restaurant-reference-badge-tripadvisor">
                                                <img src="{{ base_path }}/Images/tripadvisor_logo.webp" alt="Tripadvisor Travelers' Choice Awards 2025" class="restaurant-reference-tripadvisor-logo">
                                            </span>
                                            <span class="admin-content-reference-choice-label">{{ tripadvisor_reference_value }}</span>
                                        </span>
                                    </button>
                                </div>
                            </div>
                        {% else %}
                            <input type="text" name="{{ field.name }}" value="{{ is_editing_item ? attribute(editing_item, field.name)|default('') : '' }}" placeholder="{{ field.placeholders[app_lang] }}">
                        {% endif %}
                    </label>
                    {% endif %}
                {% endfor %}

                <button type="submit" class="contact-btn">
                    {% if is_editing_item %}
                        {{ ui[app_lang].save|format(current_item_label) }}
                    {% else %}
                        {{ ui[app_lang].add|format(current_item_label) }}
                    {% endif %}
                </button>
            </form>
        </section>

        <section class="admin-content-preview-panel admin-content-preview">
            <div class="admin-content-preview-header">
                <div>
                    <p class="property-preview-label">{{ ui[app_lang].current_sections }}</p>
                    <h2>{{ categories|length }} {{ ui[app_lang].categories }}</h2>
                </div>
            </div>

            {% if categories is empty %}
                <div class="property-empty-state">
                    <p>{{ ui[app_lang].no_categories }}</p>
                </div>
            {% else %}
                <div class="admin-content-quick-links">
                    {% for category in categories %}
                        <a href="#category-section-{{ loop.index0 }}" class="admin-content-quick-link">
                            {% if category.flag %}
                                {{ render_category_icon(category.flag) }}
                            {% endif %}
                            <span>{{ category.title }}</span>
                        </a>
                    {% endfor %}
                </div>
                <div class="admin-content-category-list">
                    {% for category in categories %}
                        {% set category_index = loop.index0 %}
                        <article class="admin-content-category-card" id="category-section-{{ category_index }}">
                            <div class="admin-content-category-header">
                                <div>
                                    <div class="admin-content-category-title-row">
                                        <h3>{{ category.title }}</h3>
                                        {% if category.flag %}
                                            {{ render_category_icon(category.flag) }}
                                        {% endif %}
                                    </div>
                                    <p>{{ category.items|length }} {{ ui[app_lang].items }}</p>
                                </div>

                                <div class="admin-content-card-actions">
                                    <form method="POST" action="{{ base_path }}/admin/content/{{ active_section }}/categories/{{ category_index }}/delete" data-admin-content-action data-confirm-message="{{ ui[app_lang].delete_category_confirm }}">
                                        <input type="hidden" name="editor_language" value="{{ editor_language }}">
                                        <button type="submit" class="account-menu-button property-delete-button">{{ ui[app_lang].delete }}</button>
                                    </form>
                                </div>
                            </div>

                            <div class="admin-content-item-list">
                                {% if category.items is empty %}
                                    <div class="admin-content-empty-items">
                                        {{ is_restaurants ? ui[app_lang].empty_restaurants : ui[app_lang].empty_items }}
                                    </div>
                                {% else %}
                                    {% for item in category.items %}
                                        {% set item_index = loop.index0 %}
                                        <article class="admin-content-item-card">
                                            <div class="admin-content-item-summary">
                                                <div class="admin-content-item-summary-main">
                                                    <h4>{{ item.name }}</h4>
                                                    <p>
                                                        {% if item.area %}<span>{{ item.area }}</span>{% endif %}
                                                        {% if item.price %}<span>{{ item.price }}</span>{% endif %}
                                                        {% if item.reference %}<span>{{ item.reference }}</span>{% endif %}
                                                    </p>
                                                </div>

                                                <div class="admin-content-card-actions">
                                                    <a href="{{ base_path }}/admin/content/{{ active_section }}?lang={{ editor_language }}&edit_item_category={{ category_index }}&edit_item={{ item_index }}" class="header-auth-link">{{ ui[app_lang].edit }}</a>

                                                    <form method="POST" action="{{ base_path }}/admin/content/{{ active_section }}/items/{{ category_index }}/{{ item_index }}/delete" data-admin-content-action data-confirm-message="{{ ui[app_lang].delete_item_confirm }}">
                                                        <input type="hidden" name="editor_language" value="{{ editor_language }}">
                                                        <button type="submit" class="account-menu-button property-delete-button">{{ ui[app_lang].delete }}</button>
                                                    </form>
                                                </div>
                                            </div>

                                            {% if item.url %}
                                                <div class="admin-content-item-meta">
                                                    <a href="{{ item.url }}" target="_blank" rel="noopener noreferrer" class="guide-link">{{ item.url_label ? item.url_label : item.url }}</a>
                                                </div>
                                            {% endif %}
                                        </article>
                                    {% endfor %}
                                {% endif %}
                            </div>
                        </article>
                    {% endfor %}
                </div>
            {% endif %}
        </section>
    </div>
</section>

<div class="admin-confirm-modal" data-admin-confirm-modal hidden>
    <button type="button" class="admin-confirm-backdrop" data-admin-confirm-cancel aria-label="{{ ui[app_lang].cancel }}"></button>
    <div class="admin-confirm-dialog" role="dialog" aria-modal="true" aria-labelledby="admin-confirm-title">
        <p class="admin-confirm-eyebrow" id="admin-confirm-title">{{ ui[app_lang].eyebrow }}</p>
        <h3>{{ ui[app_lang].delete }}</h3>
        <p data-admin-confirm-message></p>
        <div class="admin-confirm-actions">
            <button type="button" class="admin-content-cancel-link" data-admin-confirm-cancel>{{ ui[app_lang].cancel }}</button>
            <button type="button" class="account-menu-button property-delete-button" data-admin-confirm-submit>{{ ui[app_lang].delete }}</button>
        </div>
    </div>
</div>
{% endblock %}

{% block scripts %}
<script>
document.addEventListener('DOMContentLoaded', function () {
    const categoryChoice = document.querySelector('[data-category-choice]');
    const newCategoryFields = document.querySelector('[data-new-category-fields]');
    const categoryIconPicker = document.querySelector('[data-category-icon-picker]');
    const categoryIconInput = document.querySelector('[data-category-icon-input]');
    const categoryIconValue = document.querySelector('[data-category-icon-value]');
    const categoryIconPreview = document.querySelector('[data-category-icon-preview]');
    const categoryIconMenu = document.querySelector('[data-category-icon-menu]');
    const categoryIconEmpty = document.querySelector('[data-category-icon-empty]');
    const referencePicker = document.querySelector('[data-reference-picker]');
    const referenceValue = document.querySelector('[data-reference-value]');
    const referenceTrigger = document.querySelector('[data-reference-trigger]');
    const referenceTriggerContent = document.querySelector('[data-reference-trigger-content]');
    const referenceMenu = document.querySelector('[data-reference-menu]');
    const referenceOptions = Array.from(document.querySelectorAll('[data-reference-option]'));
    const categoryIconChoices = {
        {% for choice in category_icon_choices %}
        '{{ choice.code }}': {
            label: '{{ choice.name }} ({{ choice.code }})',
            html: {{ render_category_icon(choice.code)|json_encode|raw }}
        }{{ not loop.last ? ',' : '' }}
        {% endfor %}
    };

    if (!categoryChoice || !newCategoryFields) {
        return;
    }

    const syncNewCategoryFields = function () {
        const showNewCategory = categoryChoice.value === '__new__';
        newCategoryFields.classList.toggle('is-hidden', !showNewCategory);

        newCategoryFields.querySelectorAll('input').forEach(function (input) {
            input.disabled = !showNewCategory;
        });
    };

    categoryChoice.addEventListener('change', syncNewCategoryFields);
    syncNewCategoryFields();

    if (!categoryIconInput || !categoryIconPreview) {
        return;
    }

    const previewValue = categoryIconPreview.querySelector('.admin-content-icon-preview-value');
    const iconOptions = Array.from(document.querySelectorAll('.admin-content-icon-option'));

    const syncCategoryIconPreview = function () {
        const code = categoryIconValue.value.trim().toUpperCase();
        const choice = categoryIconChoices[code];

        if (!choice) {
            previewValue.textContent = code === ''
                ? '{{ ui[app_lang].no_icon }}'
                : '{{ ui[app_lang].unknown_code }}';
            return;
        }

        previewValue.innerHTML = choice.html + '<span>' + choice.label + '</span>';
    };

    const closeIconMenu = function () {
        categoryIconMenu.classList.add('is-hidden');
    };

    const filterIconOptions = function () {
        const query = categoryIconInput.value.trim().toLowerCase();
        let visibleCount = 0;

        iconOptions.forEach(function (option) {
            const code = option.dataset.iconCode.toLowerCase();
            const label = option.dataset.iconLabel.toLowerCase();
            const matches = query === '' || code.includes(query) || label.includes(query);
            option.classList.toggle('is-hidden', !matches);

            if (matches) {
                visibleCount += 1;
            }
        });

        categoryIconEmpty.classList.toggle('is-hidden', visibleCount !== 0);
    };

    const openIconMenu = function () {
        categoryIconMenu.classList.remove('is-hidden');
        filterIconOptions();
    };

    iconOptions.forEach(function (option) {
        option.addEventListener('click', function () {
            const code = option.dataset.iconCode;
            const label = option.dataset.iconLabel;
            const choice = categoryIconChoices[code];

            categoryIconValue.value = code;
            categoryIconInput.value = choice ? (label + ' (' + code + ')') : code;
            syncCategoryIconPreview();
            closeIconMenu();
        });
    });

    categoryIconInput.addEventListener('focus', openIconMenu);
    categoryIconInput.addEventListener('input', function () {
        categoryIconValue.value = '';
        openIconMenu();
        syncCategoryIconPreview();
    });
    document.addEventListener('click', function (event) {
        if (!categoryIconPicker.contains(event.target)) {
            closeIconMenu();
        }
    });

    syncCategoryIconPreview();

    if (referencePicker && referenceValue && referenceTrigger && referenceTriggerContent && referenceMenu) {
        const closeReferenceMenu = function () {
            referenceMenu.classList.add('is-hidden');
            referenceTrigger.setAttribute('aria-expanded', 'false');
        };

        const openReferenceMenu = function () {
            referenceMenu.classList.remove('is-hidden');
            referenceTrigger.setAttribute('aria-expanded', 'true');
        };

        referenceTrigger.addEventListener('click', function () {
            if (referenceMenu.classList.contains('is-hidden')) {
                openReferenceMenu();
            } else {
                closeReferenceMenu();
            }
        });

        referenceOptions.forEach(function (option) {
            option.addEventListener('click', function () {
                referenceValue.value = option.dataset.referenceValue || '';
                referenceTriggerContent.innerHTML = option.querySelector('.admin-content-reference-choice-render').innerHTML;
                closeReferenceMenu();
            });
        });

        document.addEventListener('click', function (event) {
            if (!referencePicker.contains(event.target)) {
                closeReferenceMenu();
            }
        });
    }
});
</script>
<script>
document.addEventListener('DOMContentLoaded', function () {
    const confirmModal = document.querySelector('[data-admin-confirm-modal]');
    const confirmMessage = document.querySelector('[data-admin-confirm-message]');
    const confirmSubmitButton = document.querySelector('[data-admin-confirm-submit]');
    const confirmCancelButtons = document.querySelectorAll('[data-admin-confirm-cancel]');
    const quickLinks = document.querySelectorAll('.admin-content-quick-link');
    let pendingActionForm = null;
    let highlightTimer = null;
    let highlightedElement = null;

    const submitAdminContentAction = function (form, loadingLabel) {
        const submitButton = form.querySelector('button[type="submit"]');
        const originalLabel = submitButton ? submitButton.textContent : '';

        if (submitButton) {
            submitButton.disabled = true;
            submitButton.textContent = loadingLabel;
        }

        fetch(form.action, {
            method: 'POST',
            body: new FormData(form),
            credentials: 'same-origin',
            headers: {
                'X-Requested-With': 'XMLHttpRequest'
            }
        })
            .then(function (response) {
                const nextUrl = response.url || window.location.href;

                return fetch(nextUrl, {
                    method: 'GET',
                    credentials: 'same-origin',
                    cache: 'no-store',
                    headers: {
                        'X-Requested-With': 'XMLHttpRequest'
                    }
                });
            })
            .then(function (response) {
                return response.text();
            })
            .then(function (html) {
                document.open();
                document.write(html);
                document.close();
            })
            .catch(function () {
                window.location.reload();
            })
            .finally(function () {
                if (submitButton && document.body.contains(submitButton)) {
                    submitButton.disabled = false;
                    submitButton.textContent = originalLabel;
                }
            });
    };

    const closeConfirmModal = function () {
        if (!confirmModal) {
            return;
        }

        confirmModal.hidden = true;
        document.body.classList.remove('admin-confirm-open');
        pendingActionForm = null;
    };

    const openConfirmModal = function (form) {
        if (!confirmModal || !confirmMessage) {
            return false;
        }

        pendingActionForm = form;
        confirmMessage.textContent = form.dataset.confirmMessage || '';
        confirmModal.hidden = false;
        document.body.classList.add('admin-confirm-open');
        return true;
    };

    if (confirmSubmitButton) {
        confirmSubmitButton.addEventListener('click', function () {
            if (!pendingActionForm) {
                closeConfirmModal();
                return;
            }

            const formToSubmit = pendingActionForm;
            closeConfirmModal();
            submitAdminContentAction(formToSubmit, '{{ ui[app_lang].deleting }}');
        });
    }

    confirmCancelButtons.forEach(function (button) {
        button.addEventListener('click', closeConfirmModal);
    });

    document.addEventListener('keydown', function (event) {
        if (event.key === 'Escape' && confirmModal && !confirmModal.hidden) {
            closeConfirmModal();
        }
    });

    const highlightTarget = function (target) {
        if (!target) {
            return;
        }

        if (highlightedElement && highlightedElement !== target) {
            highlightedElement.classList.remove('quick-scroll-highlight');
        }

        target.classList.remove('quick-scroll-highlight');
        void target.offsetWidth;
        target.classList.add('quick-scroll-highlight');
        highlightedElement = target;

        if (highlightTimer) {
            window.clearTimeout(highlightTimer);
        }

        highlightTimer = window.setTimeout(function () {
            target.classList.remove('quick-scroll-highlight');
            if (highlightedElement === target) {
                highlightedElement = null;
            }
        }, 1100);
    };

    const highlightAfterArrival = function (target) {
        const finish = function () {
            window.removeEventListener('scrollend', finish);
            window.removeEventListener('scroll', onScroll);
            if (scrollStopTimer) {
                window.clearTimeout(scrollStopTimer);
                scrollStopTimer = null;
            }
            highlightTarget(target);
        };

        const onScroll = function () {
            if (scrollStopTimer) {
                window.clearTimeout(scrollStopTimer);
            }

            scrollStopTimer = window.setTimeout(finish, 120);
        };

        let scrollStopTimer = null;
        window.addEventListener('scrollend', finish, { once: true });
        window.addEventListener('scroll', onScroll);
        onScroll();
    };

    quickLinks.forEach(function (link) {
        link.addEventListener('click', function (event) {
            const href = link.getAttribute('href') || '';
            const targetId = href.startsWith('#') ? href.slice(1) : '';
            const target = targetId ? document.getElementById(targetId) : null;

            if (!target) {
                return;
            }

            event.preventDefault();
            target.scrollIntoView({ behavior: 'smooth', block: 'start' });
            window.history.replaceState(null, '', '#' + targetId);
            highlightAfterArrival(target);
        });
    });

    const bindAdminContentActions = function () {
        const form = document.querySelector('[data-admin-content-form]');

        if (form && !form.dataset.ajaxBound) {
            form.dataset.ajaxBound = 'true';
            form.addEventListener('submit', function (event) {
                event.preventDefault();
                submitAdminContentAction(form, '{{ ui[app_lang].saving }}');
            });
        }

        document.querySelectorAll('[data-admin-content-action]').forEach(function (actionForm) {
            if (actionForm.dataset.ajaxBound) {
                return;
            }

            actionForm.dataset.ajaxBound = 'true';
            actionForm.addEventListener('submit', function (event) {
                event.preventDefault();
                if (actionForm.dataset.confirmMessage && openConfirmModal(actionForm)) {
                    return;
                }

                submitAdminContentAction(actionForm, '{{ ui[app_lang].deleting }}');
            });
        });
    };

    bindAdminContentActions();
});
</script>
{% endblock %}
