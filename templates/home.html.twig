<script>
document.addEventListener('DOMContentLoaded', function () {
    const tocLinks = document.querySelectorAll('[data-home-toc-target]');
    let highlightTimer = null;
    let highlightedElement = null;
    let scrollStopTimer = null;

    const resolveHighlightElement = function (target) {
        if (!target) {
            return null;
        }

        return target.querySelector('.info-request-card, .property-empty-state, .property-public-grid, .property-public-header, .property-filter-bar') || target;
    };

    const highlightTarget = function (target) {
        const element = resolveHighlightElement(target);

        if (!element) {
            return;
        }

        if (highlightedElement && highlightedElement !== element) {
            highlightedElement.classList.remove('quick-scroll-highlight');
        }

        element.classList.remove('quick-scroll-highlight');
        void element.offsetWidth;
        element.classList.add('quick-scroll-highlight');
        highlightedElement = element;

        if (highlightTimer) {
            window.clearTimeout(highlightTimer);
        }

        highlightTimer = window.setTimeout(function () {
            element.classList.remove('quick-scroll-highlight');
            if (highlightedElement === element) {
                highlightedElement = null;
            }
        }, 1100);
    };

    const highlightAfterArrival = function (target) {
        const finish = function () {
            window.removeEventListener('scrollend', finish);
            window.removeEventListener('scroll', onScroll);
            if (scrollStopTimer) {
                window.clearTimeout(scrollStopTimer);
                scrollStopTimer = null;
            }
            highlightTarget(target);
        };

        const onScroll = function () {
            if (scrollStopTimer) {
                window.clearTimeout(scrollStopTimer);
            }

            scrollStopTimer = window.setTimeout(finish, 120);
        };

        window.addEventListener('scrollend', finish, { once: true });
        window.addEventListener('scroll', onScroll);
        onScroll();
    };

    tocLinks.forEach(function (link) {
        link.addEventListener('click', function (event) {
            const targetId = link.getAttribute('data-home-toc-target');
            const target = targetId ? document.getElementById(targetId) : null;

            if (!target) {
                return;
            }

            event.preventDefault();

            const header = document.querySelector('.site-header');
            const headerHeight = header ? header.offsetHeight : 0;
            const rect = target.getBoundingClientRect();
            const targetTop = window.scrollY + rect.top;
            const centeredOffset = Math.max(80, (window.innerHeight - rect.height) / 2);
            const scrollTop = Math.max(0, targetTop - centeredOffset - (headerHeight / 2));

            window.history.replaceState(null, '', '#' + targetId);
            window.scrollTo({
                top: scrollTop,
                behavior: 'smooth'
            });
            highlightAfterArrival(target);
        });
    });
});
</script>
