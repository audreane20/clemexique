                <span class="home-toc-link-copy">{{ trans('home.toc_buy_copy') }}</span>
            </a>
            <a href="#home-info-request-rent" class="home-toc-link" data-home-toc-target="home-info-request-rent">
                <span class="home-toc-link-title">{{ trans('home.toc_info_rent_title') }}</span>
                <span class="home-toc-link-copy">{{ trans('home.toc_info_rent_copy') }}</span>
            </a>
            <a href="#home-residency" class="home-toc-link" data-home-toc-target="home-residency">
                <span class="home-toc-link-title">{{ trans('home.toc_residency_title') }}</span>
                <span class="home-toc-link-copy">{{ trans('home.toc_residency_copy') }}</span>
            </a>
            <a href="#home-rental" class="home-toc-link" data-home-toc-target="home-rental">
                <span class="home-toc-link-title">{{ trans('home.toc_rental_title') }}</span>
                <span class="home-toc-link-copy">{{ trans('home.toc_rental_copy') }}</span>
            </a>
            <a href="#home-management" class="home-toc-link" data-home-toc-target="home-management">
                <span class="home-toc-link-title">{{ trans('home.toc_management_title') }}</span>
                <span class="home-toc-link-copy">{{ trans('home.toc_management_copy') }}</span>
            </a>
            <a href="#home-restaurants" class="home-toc-link" data-home-toc-target="home-restaurants">
                <span class="home-toc-link-title">{{ trans('home.toc_restaurants_title') }}</span>
                <span class="home-toc-link-copy">{{ trans('home.toc_restaurants_copy') }}</span>
            </a>
            <a href="#home-excursions" class="home-toc-link" data-home-toc-target="home-excursions">
                <span class="home-toc-link-title">{{ trans('home.toc_excursions_title') }}</span>
                <span class="home-toc-link-copy">{{ trans('home.toc_excursions_copy') }}</span>
            </a>
            <a href="#home-playa-guide" class="home-toc-link" data-home-toc-target="home-playa-guide">
                <span class="home-toc-link-title">{{ trans('home.toc_playa_guide_title') }}</span>
                <span class="home-toc-link-copy">{{ trans('home.toc_playa_guide_copy') }}</span>
            </a>
        </div>
    </div>
</section>

<section class="property-public-shell" id="home-properties">
    <div class="property-public-header">
        <h1>{{ trans('properties.title') }}</h1>
    </div>

    {% if properties is empty %}
        <div class="property-empty-state property-empty-state-public">
            <p>{{ trans('properties.empty') }}</p>
        </div>
    {% else %}
        {% set property_count = properties|length %}
        {% if property_count <= 5 %}
            {% set property_rows = [properties] %}
        {% elseif property_count == 6 %}
            {% set property_rows = [properties|slice(0, 3), properties|slice(3, 3)] %}
        {% elseif property_count == 7 %}
            {% set property_rows = [properties|slice(0, 3), properties|slice(3, 4)] %}
        {% elseif property_count == 8 %}
            {% set property_rows = [properties|slice(0, 4), properties|slice(4, 4)] %}
        {% elseif property_count == 9 %}
            {% set property_rows = [properties|slice(0, 4), properties|slice(4, 5)] %}
        {% elseif property_count == 10 %}
            {% set property_rows = [properties|slice(0, 5), properties|slice(5, 5)] %}
        {% else %}
            {% set property_rows = properties|batch(5) %}
        {% endif %}

        <div class="property-public-grid">
            {% for property_row in property_rows %}
                <div class="property-public-row property-public-row-{{ property_row|length }}">
                    {% for property in property_row %}
                        <article class="property-public-card">
                            <img src="{{ property.image_url }}" alt="{{ property.name }}" class="property-public-image">

                            <h2>{{ property.name }}</h2>
                            <p class="property-public-city">{{ property.city }}</p>
                            <p class="property-public-price property-public-price-primary">{{ trans('properties.starting_from') }} {{ property.primary_price_display }}</p>
                            <p class="property-public-price property-public-price-secondary">{{ trans('properties.starting_from') }} {{ property.secondary_price_display }}</p>

                            <a href="{{ base_path ~ property.detail_url ~ '?lang=' ~ app_lang }}" class="property-public-link">
                                {{ trans('properties.cta') }}
                            </a>
                        </article>
                    {% endfor %}
                </div>
            {% endfor %}
        </div>
    {% endif %}
</section>

