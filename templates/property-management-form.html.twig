{% extends "layout.html.twig" %}

{% block content %}
<section class="rental-form-page">
    <section class="residency-hero">
        <p>{{ trans('property_management.hero') }}</p>
    </section>

    <div class="rental-form-shell">
        <div class="rental-form-intro">
            <h1>{{ trans('management_form.title') }}</h1>
            <p>{{ trans('management_form.subtitle') }}</p>
            <p class="rental-form-required">{{ trans('management_form.required_notice') }}</p>
        </div>

        {% if success %}
            <div class="form-success">{{ trans('management_form.success') }}</div>
        {% endif %}

        {% if error %}
            <div class="form-error">{{ error }}</div>
        {% endif %}

        <form method="POST" action="{{ base_path }}/gestion-immobiliere/formulaire?lang={{ app_lang }}" class="rental-form">
            <input type="hidden" name="preferred_language" value="{{ app_lang }}">

            <section class="rental-question-card">
                <label class="rental-question-title" for="management-full-name">{{ trans('management_form.full_name') }} <span>*</span></label>
                <input id="management-full-name" type="text" name="full_name" value="{{ form_data.full_name }}" class="rental-text-input" required>
            </section>

            <section class="rental-question-card">
                <label class="rental-question-title" for="management-account-email">{{ trans('management_form.account_email') }} <span>*</span></label>
                <input id="management-account-email" type="email" name="account_email" value="{{ form_data.account_email }}" class="rental-text-input" required>
            </section>

            <section class="rental-question-card">
                <label class="rental-question-title" for="management-phone">{{ trans('management_form.phone') }} <span>*</span></label>
                <input id="management-phone" type="text" name="phone" value="{{ form_data.phone }}" class="rental-text-input" required>
            </section>

            <section class="rental-question-card">
                <fieldset class="rental-fieldset">
                    <legend class="rental-question-title">{{ trans('management_form.property_city') }} <span>*</span></legend>
                    <div class="rental-options">
                        <label><input type="radio" name="property_city" value="playa_del_carmen" {{ form_data.property_city == 'playa_del_carmen' ? 'checked' : '' }} required><span>{{ trans('management_form.city_playa_del_carmen') }}</span></label>
                        <label><input type="radio" name="property_city" value="cancun" {{ form_data.property_city == 'cancun' ? 'checked' : '' }} required><span>{{ trans('management_form.city_cancun') }}</span></label>
                        <label><input type="radio" name="property_city" value="tulum" {{ form_data.property_city == 'tulum' ? 'checked' : '' }} required><span>{{ trans('management_form.city_tulum') }}</span></label>
                        <label><input type="radio" name="property_city" value="puerto_morelos" {{ form_data.property_city == 'puerto_morelos' ? 'checked' : '' }} required><span>{{ trans('management_form.city_puerto_morelos') }}</span></label>
                        <label><input type="radio" name="property_city" value="akumal" {{ form_data.property_city == 'akumal' ? 'checked' : '' }} required><span>{{ trans('management_form.city_akumal') }}</span></label>
                        <div class="rental-other-row">
                            <label><input type="radio" name="property_city" value="other" {{ form_data.property_city == 'other' ? 'checked' : '' }} required><span>{{ trans('management_form.other') }}</span></label>
                            <input type="text" name="property_city_other" value="{{ form_data.property_city_other }}" class="rental-inline-input" placeholder="{{ trans('management_form.other_placeholder') }}">
                        </div>
                    </div>
                </fieldset>
            </section>

            <section class="rental-question-card">
                <label class="rental-question-title" for="management-possession-date">{{ trans('management_form.possession_date') }} <span>*</span></label>
                <input id="management-possession-date" type="date" name="possession_date" value="{{ form_data.possession_date }}" class="rental-date-input" required>
            </section>

            <section class="rental-question-card">
                <fieldset class="rental-fieldset">
                    <legend class="rental-question-title">{{ trans('management_form.preferred_contact') }} <span>*</span></legend>
                    <div class="rental-options">
                        <label><input type="radio" name="preferred_contact" value="email" {{ form_data.preferred_contact == 'email' ? 'checked' : '' }} required><span>{{ trans('management_form.contact_option_email') }}</span></label>
                        <label><input type="radio" name="preferred_contact" value="whatsapp" {{ form_data.preferred_contact == 'whatsapp' ? 'checked' : '' }} required><span>{{ trans('management_form.contact_option_whatsapp') }}</span></label>
                    </div>
                </fieldset>
            </section>

            <div class="rental-form-actions">
                <button type="submit" class="info-request-link rental-submit-button">{{ trans('management_form.submit') }}</button>
            </div>
        </form>
    </div>
</section>
<script>
document.addEventListener('DOMContentLoaded', function () {
    const otherRadio = document.querySelector('input[name="property_city"][value="other"]');
    const textInput = document.querySelector('input[name="property_city_other"]');

    if (!otherRadio || !textInput) {
        return;
    }

    const updateState = function () {
        textInput.disabled = !otherRadio.checked;
    };

    document.querySelectorAll('input[name="property_city"]').forEach(function (radio) {
        radio.addEventListener('change', updateState);
    });

    textInput.addEventListener('focus', function () {
        otherRadio.checked = true;
        updateState();
    });

    updateState();
});
</script>
{% endblock %}
