{% extends "layout.html.twig" %}

{% block content %}
<section class="admin-properties-shell">
    <div class="admin-properties-header">
        <div>
            <p class="admin-properties-eyebrow">{{ trans('properties.admin_eyebrow') }}</p>
            <h1>{{ trans('properties.admin_title') }}</h1>
            <p>{{ trans('properties.admin_copy') }}</p>
        </div>
    </div>

    <div class="admin-properties-layout">
        <div class="property-form-card">
            <h2>{{ editing_property ? trans('properties.edit_title') : trans('properties.form_title') }}</h2>

            <form method="POST" action="{{ editing_property ? base_path ~ '/admin/properties/' ~ editing_property.id ~ '/update' : base_path ~ '/admin/properties/create' }}" class="property-form" enctype="multipart/form-data">
                <label>
                    {{ trans('properties.pictures') }}
                    <input type="file" name="image_files[]" accept="image/*" multiple {{ editing_property ? '' : 'required' }}>
                    <small class="property-field-help">{{ trans('properties.pictures_help') }}</small>
                </label>

                <label>
                    {{ trans('properties.name') }}
                    <input type="text" name="name" placeholder="Tohoku Living" value="{{ editing_property.name ?? '' }}" required>
                </label>

                <label>
                    {{ trans('properties.city') }}
                    <input type="text" name="city" placeholder="Playa del Carmen" value="{{ editing_property.city ?? '' }}" required>
                </label>

                <label>
                    {{ trans('properties.description') }}
                    <textarea name="description" rows="8" placeholder="{{ trans('properties.description_placeholder') }}" required>{{ editing_property.description ?? '' }}</textarea>
                </label>

                <fieldset class="property-form-choice">
                    <legend>{{ trans('properties.type') }}</legend>
                    <div class="property-radio-group">
                        <label class="property-radio-option">
                            <input type="radio" name="listing_mode" value="achat" {{ (editing_property.listing_mode ?? 'achat') == 'achat' ? 'checked' : '' }}>
                            <span>{{ trans('properties.mode_buy') }}</span>
                        </label>

                        <label class="property-radio-option">
                            <input type="radio" name="listing_mode" value="location" {{ (editing_property.listing_mode ?? 'achat') == 'location' ? 'checked' : '' }}>
                            <span>{{ trans('properties.mode_rent') }}</span>
                        </label>
                    </div>
                </fieldset>

                <div class="property-form-row">
                    <label>
                        {{ trans('properties.price') }}
                        <input type="number" name="price_amount" step="0.01" min="0" placeholder="0" value="{{ editing_property.price_amount ?? '' }}" required>
                    </label>

                    <label>
                        {{ trans('properties.currency') }}
                        <select name="price_currency" required>
                            <option value="CAD" {{ (editing_property.price_currency ?? 'CAD') == 'CAD' ? 'selected' : '' }}>CAD</option>
                            <option value="USD" {{ (editing_property.price_currency ?? 'CAD') == 'USD' ? 'selected' : '' }}>USD</option>
                        </select>
                    </label>
                </div>

                <button type="submit" class="contact-btn">{{ editing_property ? trans('properties.update') : trans('properties.save') }}</button>

                {% if editing_property %}
                    <a href="{{ base_path }}/admin/properties" class="property-cancel-link">{{ trans('properties.cancel_edit') }}</a>
                {% endif %}
            </form>
        </div>

        <div class="property-admin-preview">
            <div class="property-admin-preview-header">
                <div>
                    <p class="property-preview-label">{{ trans('properties.current') }}</p>
                    <h2>{{ properties|length }} {{ properties|length == 1 ? trans('properties.card_singular') : trans('properties.card_plural') }}</h2>
                </div>
            </div>

            {% if properties is empty %}
                <div class="property-empty-state">
                    <p>{{ trans('properties.admin_empty') }}</p>
                </div>
            {% else %}
                <div class="property-admin-grid">
                    {% for property in properties %}
                        <article class="property-admin-card">
                            <img src="{{ property.image_url }}" alt="{{ property.name }}">

                            <div class="property-admin-card-body">
                                <p class="property-admin-mode">{{ property.listing_mode == 'location' ? trans('properties.mode_rent') : trans('properties.mode_buy') }}</p>
                                <h3>{{ property.name }}</h3>
                                <p class="property-admin-city">{{ property.city }}</p>
                                <p class="property-admin-price">{{ property.price_display }}</p>
                                <p class="property-admin-count">{{ property.image_count }} {{ property.image_count == 1 ? trans('properties.photo_singular') : trans('properties.photo_plural') }}</p>

                                <div class="property-admin-actions">
                                    <a href="{{ base_path ~ property.detail_url ~ '?lang=' ~ app_lang }}" class="header-auth-link property-open-link">{{ trans('properties.open_page') }}</a>

                                    <div class="property-admin-secondary-actions">
                                        <a href="{{ base_path }}/admin/properties?edit={{ property.id }}" class="account-menu-button property-edit-link">{{ trans('properties.edit') }}</a>

                                        <form method="POST" action="{{ base_path }}/admin/properties/{{ property.id }}/delete" onsubmit="return confirm('{{ trans('properties.delete_confirm') }}');">
                                            <button type="submit" class="account-menu-button property-delete-button">{{ trans('properties.delete') }}</button>
                                        </form>
                                    </div>
                                </div>
                            </div>
                        </article>
                    {% endfor %}
                </div>
            {% endif %}
        </div>
    </div>

    {% if editing_property and editing_property.images is not empty %}
        <div class="property-gallery-admin-card">
            <div class="property-admin-preview-header">
                <div>
                    <p class="property-preview-label">{{ trans('properties.current_photos') }}</p>
                    <h2>{{ editing_property.name }}</h2>
                </div>
            </div>

            <div class="property-gallery-admin-grid">
                {% for image in editing_property.images %}
                    <img src="{{ image }}" alt="{{ editing_property.name }} photo {{ loop.index }}">
                {% endfor %}
            </div>
        </div>
    {% endif %}
</section>
{% endblock %}
