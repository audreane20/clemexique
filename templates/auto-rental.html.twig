{% extends "layout.html.twig" %}

{% block content %}
<section class="about-hero">
    <p>{{ trans('auto_rental.hero') }}</p>
</section>

<section class="residency-container">
    <div class="page-intro-card">
        <h1>{{ trans('auto_rental.title') }}</h1>
        <p>{{ trans('auto_rental.intro_lead') }}</p>
        <p>{{ trans('auto_rental.intro_p1') }}</p>
        <p>{{ trans('auto_rental.intro_p2') }}</p>
        <p>{{ trans('auto_rental.intro_p3') }}</p>
    </div>

    <div class="residency-note">
        <h2>{{ trans('auto_rental.section_title') }}</h2>
        <p>{{ trans('auto_rental.section_copy') }}</p>
    </div>

    <div class="page-home-actions">
        <a href="https://www.saleahomes.com/location-automobile-rentalcar" class="info-request-link" target="_blank" rel="noopener noreferrer">{{ trans('auto_rental.cta') }}</a>
        <a href="{{ base_path }}/?lang={{ app_lang }}" class="info-request-link page-home-link">{{ trans('common.back_home') }}</a>
    </div>
</section>
{% endblock %}
